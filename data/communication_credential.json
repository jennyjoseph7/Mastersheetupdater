{
  "timezone": "Asia/Kolkata",
  "name": "communication_credential",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "provider_id",
      "refers": "parents.communication_provider.provider_id",
      "required": true
    },
    {
      "name": "provider_name",
      "refers": "parents.communication_provider.provider_name",
      "indexed": true
    },
    {
      "name": "channel",
      "refers": "parents.communication_provider.channel"
    },
    {
      "name": "webhook_url",
      "type": "text"
    },
    {
      "required": true,
      "name": "sender",
      "type": "text"
    },
    {
        "name":"auth_token",
        "type":"text"
    },
    
    {
        "name" : "password",
        "type" : "uuid",
        "default" : {
        "function" : "make_view_id",
        "kwargs":{
                "make_unique":false
            }
        }
    },
    {
      "name": "dealership_id",
      "refers": "parents.dealership.dealership_id",
      "required":false
    },
    {
      "name": "region_name",
      "type": "parents.dealership.region_name"
    },
    {
      "name": "dealer_name",
      "type": "parents.dealership.dealer_name"
    },
    {
      "name": "auth_creds",
      "type": "nested_object"
    },
    {
      "name": "auth_headers",
      "type": "nested_object"
    },
    {
      "name": "caller_name",
      "type": "text"
    },
    {
      "name": "bot_name",
      "type": "text"
    },

    {
      "auto_updater": true,
      "default": {
        "args": ["provider_name", "sender","caller_name","bot_name"],
        "function": "name_to_id",
        "kwargs": {
          "is_unique": true,
          "separator": "_",
          "skip_empty": true
        }
      },
      "name": "communication_credentials_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents":["communication_provider","dealership"]
}
