{
    "timezone": "Asia/Kolkata",
    "name": "message",
    "model_type": "default",
    "attributes": [
        
        {
            "name" : "id_salt",
            "type" : "text",
            "default" : {
                "function" : "make_view_id",
                "kwargs":{
                    "make_unique":false
                }
            }
        },
        {
            "name": "created",
            "type": "datetime",
            "auto_updater": true,
            "default": {
                "function": "now"
            }
        },
        {
            "name": "updated",
            "type": "datetime",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now"
            }
        },
        {
            "name" : "sender_id",
            "type" : "text"
        },
        {
            "name" : "message_initiated",
            "type" : "number"
        },
        {
            "name" : "user_sent_time",
            "type" : "number"
        },
        {
            "name" : "webhook_received_time",
            "type" : "number"
        },
        {
            "name" : "conversation_process_start_time",
            "type" : "number"
        },
        {
            "name" : "conversation_process_end_time",
            "type" : "number"
        },
        {
            "name" : "response_sent_start_time",
            "type" : "number"
        },
        {
            "name" : "response_sent_time",
            "type" : "number"
        },
        {
            "name" : "response_delivered_time",
            "type" : "number"
        },

        {
            "name" : "reply_to_message_id",
            "type" : "text"
        },
        {
            "name" : "reply_to_sender_id",
            "type" : "text"
        },
        {
            "name": "delivered_to",
            "adder": {
                "function": "list_adder",
                "kwargs": {
                    "unique": true
                }
            },
            "type": "list",
            "default": []
        },
        {
            "name": "session_id",
            "type": "text",
            "indexed": true
        },
        {
            "name": "campaign_id",
            "type": "text"
        },
        {
            "type" : "text",
            "name" : "channel"
        },
        {
            "name": "role",
            "type": "text",
            "options" : [
                "user",
                "human_agent",
                "system"
            ]
        },
        {
            "name": "message_text",
            "type": "text"
        },
        {
            "name" : "index",
            "type" : "number",
            "default" : 0
        },
        {
            "name": "message_data",
            "type": "nested_object"
        },
        {
            "name" : "message_type",
            "type" : "text",
            "options" : [
                "text",
                "audio",
                "video",
                "image",
                "template"
            ]
        },
        {
            "name" : "agent_id",
            "type" : "text"
        },
        {
            "name": "status",
            "type": "text",
            "options": [
                "sent",
                "delivered",
                "failed",
                "read",
                "error"
            ],
            "indexed": true
        },
        {
            "name" : "feedback",
            "type" : "text"
        },
        {
            "name" : "channel_message_id",
            "type" : "text"
        },
        {
            "name": "message_id",
            "type": "uid",
            "indexed": true,
            "id": true,
            "default": {
                "function": "make_uuid3",
                "args": [
                    "created",
                    "id_salt",
                    "sender_id",
                    "session_id",
                    "message_text"
                ]
            }
        }
    ]
}