{
  "timezone": "Asia/Kolkata",
  "name": "variant_color",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "variant_id",
      "refers": "parents.variant.variant_id"
    },
    {
      "name": "variant_name",
      "refers": "parents.variant.variant_name"
    },
    {
      "name": "model_id",
      "refers": "parents.variant.model_id"
    },
    {
      "name": "model_name",
      "refers": "parents.variant.model_name"
    },
    {
      "name": "brand_id",
      "refers": "parents.variant.brand_id"
    },
    {
      "name": "brand_name",
      "refers": "parents.variant.brand_name"
    },
    {
      "name": "color_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "hex_code",
      "type": "text"
    },
    {
      "name": "finish_type",
      "type": "text",
      "options": ["Metallic", "Matte", "Pearl", "Solid"],
      "ui_element": "select"
    },
    {
      "name": "availability_status",
      "type": "text",
      "options": ["Available", "Limited", "Discontinued"],
      "ui_element": "select"
    },
    {
      "name": "image_url",
      "type": "text"
    },
    {
      "name": "price_difference",
      "type": "number"
    },
    {
      "name": "variant_color_status",
      "type": "text",
      "options": ["Active", "Inactive"],
      "ui_element": "select"
    },
    {
      "auto_updater": true,
      "default": {
        "args": ["brand_name", "model_name", "variant_name", "color_name", "finish_type"],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "variant_color_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": ["variant"]
}
