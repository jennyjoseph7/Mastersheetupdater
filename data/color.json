{
  "timezone": "Asia/Kolkata",
  "name": "color",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": { "function": "now_ctime" }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": { "function": "now_ctime" }
    },
    {
      "name": "brand_id",
      "refers": "parents.model.brand_id"
    },
    {
      "name": "brand_name",
      "refers": "parents.model.brand_name"
    },
    {
      "name": "color_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "paint_code",
      "type": "text",
      "title": "Manufacturer Paint Code"
    },
    {
      "name": "hex_code",
      "type": "text"
    },
    {
      "name": "rgb_code",
      "type": "text"
    },
    {
      "name": "finish_type",
      "type": "text",
      "options": ["Metallic", "Matte", "Pearl", "Solid", "Satin", "Chrome"],
      "ui_element": "select"
    },
    {
      "name": "tone_type",
      "type": "text",
      "options": ["Single Tone", "Dual Tone", "Triple Tone"],
      "ui_element": "select"
    },
    {
      "name": "secondary_tone",
      "type": "nested_object",
      "dict_keys": ["color_name", "hex_code", "finish_type"],
      "title": "Secondary Tone (for Dual Tone)"
    },
    {
      "name": "tertiary_tone",
      "type": "nested_object",
      "dict_keys": ["color_name", "hex_code", "finish_type"],
      "title": "Tertiary Tone (for Triple Tone)"
    },
    {
      "name": "tone_description",
      "type": "text",
      "title": "Tone Combination Description"
    },
    {
      "name": "texture",
      "type": "text"
    },
    {
      "name": "description",
      "type": "text",
      "title": "Color Description"
    },
    {
      "name": "image_url",
      "type": "text",
      "ui_element": "image"
    },
    {
      "name": "gallery_images",
      "type": "list",
      "title": "Gallery Images"
    },
    {
      "name": "additional_cost",
      "type": "number"
    },
    {
      "name": "dual_tone_extra_cost",
      "type": "number",
      "title": "Additional Cost for Dual Tone"
    },
    {
      "name": "triple_tone_extra_cost",
      "type": "number",
      "title": "Additional Cost for Triple Tone"
    },
    {
      "name": "availability_status",
      "type": "text",
      "options": ["Available", "Limited", "Discontinued", "Upcoming"],
      "ui_element": "select"
    },
    {
      "name": "launch_date",
      "type": "number",
            "default": {
                "function": "now_ctime"
            }
    },
    {
      "name": "discontinuation_date",
      "type": "number",
            "default": {
                "function": "now_ctime"
            }
    },
    {
      "name": "compatible_variants",
      "type": "object_list",
      "list_type": "nested_object",
      "dict_keys": ["variant_id", "variant_name", "fuel_type", "transmission"],
      "title": "Compatible Variants"
    },
    {
      "name": "notes",
      "type": "text"
    },
    {
      "name": "color_status",
      "type": "text",
      "options": ["Active", "Inactive"],
      "ui_element": "select"
    },
    {
      "auto_updater": true,
      "default": {
        "args": ["brand_name", "color_name", "finish_type", "tone_type"],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "color_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": ["model"]
}
