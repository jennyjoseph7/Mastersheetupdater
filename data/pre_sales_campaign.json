{
  "timezone": "Asia/Kolkata",
  "name": "pre_sales_campaign",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "dealership_id",
      "refers": "parents.dealership.dealership_id",
      "required": true
    },
    {
      "name": "dealer_name",
      "refers": "parents.dealership.dealer_name"
    },
    {
      "name": "dealership_type",
      "refers": "parents.dealership.dealership_type"
    },
    {
      "name": "region_name",
      "refers": "parents.dealership.region_name"
    },
    {
      "name": "campaign_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "campaign_type",
      "type": "text",
      "default": "pre-sales"
    },
    {
      "name": "campaign_user_source",
      "type": "nested_object",
      "required": true
    },
    {
      "name": "campaign_objective",
      "type": "list",
      "options": [
        "Product Launch / Reveal",
        "Event Promotion",
        "Cold List Activation",
        "Event/Expo Data Activation",
        "Dormant CRM Reactivation",
        "Interest Confirmation & Qualification",
        "Profile Completion Campaign",
        "Dealer / OEM Offer Promotion",
        "Exchange / Loyalty Bonus Offer",
        "EMI / Finance Scheme Push",
        "Year-End / Stock Clearance",
        "New Variant / Feature Highlight",
        "Price Drop / Offer Re-Nudge",
        "Comparison / Decision Aid Campaign",
        "Test Drive Reminder / Showroom Visit Reminder / Follow-Up",
        "Accessory Promotion",
        "Insurance / Finance Add-On",
        "Upgrade Offer for Existing Owner",
        "Custom Campaign"
      ],
      "option_others": true
    },
    {
      "name": "campaign_objective_type",
      "type": "list",
      "options": ["lead volume", "budget based", "roi target"]
    },
    {
      "name": "campaign_sub_type",
      "type": "list",
      "options": [
        "brand awareness",
        "product awareness",
        "event",
        "lead generation"
      ],
      "option_others": true
    },
    {
      "name": "campaign_offer",
      "type": "text"
    },
    {
      "name": "campaign_description",
      "type": "text"
    },
    {
      "name": "start_date",
      "type": "number"
    },
    {
      "name": "end_date",
      "type": "number"
    },
    {
      "name": "channels",
      "refers": "parents.dealership.channels"
    },
    {
      "name": "languages",
      "default": "english",
      "type": "string_list",
      "option_others": true,
      "ui_element": "tags",
      "options": [
        "english",
        "hindi",
        "kannada",
        "telugu",
        "tamil",
        "malayalam",
        "odia",
        "bengali",
        "marathi",
        "gujarati",
        "bengali",
        "assamese",
        "punjabi",
        "spanish",
        "arabic"
      ]
    },
    {
      "name": "urgency_hook",
      "type": "text"
    },
    {
      "name": "number_targeted",
      "type": "number"
    },
    {
      "name": "number_reached",
      "type": "number"
    },
    {
      "name": "number_contacted",
      "type": "number"
    },
    {
      "name": "number_engaged",
      "type": "number"
    },
    {
      "name": "number_converted",
      "type": "number"
    },
    {
      "name": "budget_allocated",
      "type": "number"
    },
    {
      "name": "actual_spent",
      "type": "number"
    },
    {
      "name": "conversion_rate_percent",
      "type": "number",
      "default": {
        "function": "divide_attributes",
        "args": ["number_converted", "number_contacted"]
      }
    },
    {
      "name": "cost_per_lead",
      "type": "number",
      "default": {
        "function": "divide_attributes",
        "args": ["actual_spent", "number_converted"]
      }
    },
    {
      "name": "campaign_status",
      "type": "text",
      "options": ["Planned", "Active", "Completed", "On Hold", "Cancelled"]
    },
    {
      "name": "responsible_person",
      "type": "text"
    },
    {
      "name": "remarks",
      "type": "text"
    },
    {
      "default": {
        "function": "make_uuid3",
        "args": [
          "dealership_name",
          "campaign_name",
          "start_date",
          "campaign_type",
          "campaign_objective"
        ]
      },
      "name": "campaign_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "dealership"
  ]
}