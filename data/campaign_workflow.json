{
    "name": "campaign_workflow",
    "attributes": [
        {
            "name": "campaign_type",
            "type": "text",
            "required": true,
            "indexed": true,
            "options": [
                "pre-sales",
                "post-sales",
                "buyback",
                "dealership"
            ]
        },
        {
            "name": "campaign_model",
            "type": "text",
            "options": [
                "pre_sales_campaign",
                "post_sales_campaign",
                "buyback_campaign",
                "dealership_campaign"
            ],
            "auto_updater": true,
            "force_update": [
                "campaign_id"
            ],
            "default": {
                "function": "attribute_mapper",
                "args": [
                    "campaign_type",
                    null
                ],
                "kwargs": {
                    "pre-sales": "pre_sales_campaign",
                    "post-sales": "post_sales_campaign",
                    "dealership": "dealership_campaign"
                }
            }
        },
        {
            "name": "campaign_objective_id",
            "type": "uid",
            "required": true,
            "indexed": true
        },
        {
            "name": "campaign_objective_name",
            "type": "text",
            "force_update": [
                "campaign_objective_id"
            ],
            "auto_updater": true,
            "default": {
                "function": "get_from_model",
                "args": [
                    "campaign_objective",
                    "campaign_objective_id",
                    "campaign_objective_name"
                ]
            }
        },
        {
            "name": "dealership_id",
            "type": "uid",
            "force_update": [
                "campaign_objective_id"
            ],
            "default": {
                "function": "get_from_model",
                "args": [
                    "campaign_objective",
                    "campaign_objective_id",
                    "dealership_id",
                    "dave-ai-india"
                ]
            }
        },
        {
            "name": "dealership_name",
            "type": "uid",
            "force_update": [
                "campaign_objective_id"
            ],
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_name"
                ]
            }
        },
        {
            "name": "channel",
            "type": "text",
            "indexed": true,
            "required": true,
            "options": [
                "rcs",
                "whatsapp",
                "email",
                "web_chat",
                "web_chat_voice",
                "fb_chat",
                "insta_chat",
                "twitter_chat",
                "voice_phone",
                "whatsapp_chat",
                "whatsapp_voice_note",
                "whatsapp_voice_call",
                "zoom_bot",
                "ms_teams"
            ]
        },
        {
            "name": "campaign_workflow_stage",
            "type": "text",
            "options": [
                "queued",
                "attempted",
                "reached",
                "contacted",
                "engaged",
                "converted",
                "failed",
                "error"
            ],
            "option_others": true
        },
        {
            "name": "retries",
            "type": "number",
            "default": 0
        },
        {
            "name": "delay",
            "type": "number",
            "default": 10
        },
        {
            "name": "delay_type",
            "type": "text",
            "default": "constant",
            "options": [
                "v_function",
                "linear",
                "exponential",
                "constant"
            ],
            "ui_element": "select"
        },
        {
            "name": "trigger",
            "type": "uid",
            "option_others": true,
            "options": [
                "switch_to_next_credential",
                "switch_to_next_channel",
                "follow_up_contact",
                "confirmation_message"
            ]
        },
        {
            "name": "delay_param",
            "type": "number",
            "default": 1
        },
        {
            "name": "minimum_delay",
            "type": "number",
            "default": 7200
        },
        {
            "name": "maximum_delay",
            "type": "number",
            "default": 432000
        },
        {
            "name": "stop_period",
            "type": "number",
            "default": 2592000
        }
    ]
}