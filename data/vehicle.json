        {
            "name": "insurance",
            "type": "nested_object",
            "dict_keys": [
                "policy_number",
                "provider",
                "expiry_date",
                "insured_value"
            ]
        },
        {
            "name": "puc",
            "type": "nested_object",
            "dict_keys": [
                "certificate_number",
                "expiry_date"
            ]
        },
        {
            "name": "gps_tracker",
            "type": "nested_object",
            "dict_keys": [
                "device_id",
                "installed_date",
                "last_location",
                "last_online"
            ]
        },
        {
            "name": "current_location",
            "type": "geolocation",
            "title": "Current GPS Location"
        },
        {
            "name": "last_trip_summary",
            "type": "nested_object",
            "dict_keys": [
                "trip_distance_km",
                "avg_speed_kmph",
                "fuel_used_ltr",
                "duration_min"
            ]
        },
        {
            "name": "documents",
            "type": "object_list",
            "list_type": "nested_object",
            "dict_keys": [
                "doc_type",
                "doc_number",
                "expiry_date",
                "file_url"
            ]
        },
