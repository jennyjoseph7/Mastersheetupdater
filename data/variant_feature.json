{
  "timezone": "Asia/Kolkata",
  "name": "variant_feature",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": { "function": "now_ctime" }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": { "function": "now_ctime" }
    },
    { "name": "variant_id", "refers": "parents.variant.variant_id" },
    { "name": "variant_name", "refers": "parents.variant.variant_name" },
    { "name": "feature_id", "refers": "parents.feature.feature_id" },
    { "name": "feature_name", "refers": "parents.feature.feature_name" },
    { "name": "feature_category", "refers": "parents.feature.feature_category" },
    { "name": "aliases", "refers": "parents.feature.aliases" },
    { "name": "feature_description", "refers": "parents.feature.feature_description" },

    {
      "name": "feature_category",
      "refers": "parents.feature.feature_category"
    },
    {
      "name": "feature_type",
      "refers": "parents.feature.feature_type"
    },
    {
      "name": "availability_status",
      "refers": "parents.feature.availability_status"
    },
    {
      "name": "feature_value",
      "type": "text",
      "title": "Feature Value / Specification"
    },
    {
      "name": "unit_of_measure",
      "refers": "parents.feature.unit_of_measure"
    },
    {
      "name": "is_standard",
      "type": "bool",
      "default": false
    },
    {
      "name": "is_optional",
      "type": "bool",
      "default": false
    },
    {
      "name": "is_package_feature",
      "type": "bool",
      "default": false
    },
    {
      "name": "package_name",
      "type": "text",
      "title": "Package (If Applicable)"
    },
    {
      "name": "additional_cost",
      "type": "number",
      "units": "INR"
    },
    {
      "name": "launch_date",
      "type": "datetime"
    },
    {
      "name": "discontinuation_date",
      "type": "datetime"
    },
    {
      "name": "images",
      "type": "list",
      "title": "Feature Images"
    },
    {
      "name": "videos",
      "type": "list",
      "title": "Feature Videos"
    },
    {
      "name": "remarks",
      "type": "text"
    },
    {
      "name": "status",
      "type": "text",
      "options": ["Active", "Inactive", "Discontinued"],
      "ui_element": "select"
    },
    {
      "auto_updater": true,
      "default": {
        "args": ["variant_name", "feature_name"],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "variant_feature_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "variant",
    "feature"
  ]
}
