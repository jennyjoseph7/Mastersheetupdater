        "workshop awareness",
        "event",
        "new product lauch",
        "offers",
        "new accessories",
        "new procedures",
        "customer retention",
        "service reminder",
        "upsell/cross-sell",
        "feedback",
        "reminder",
        "product recall",
        "software update",
        "other"
