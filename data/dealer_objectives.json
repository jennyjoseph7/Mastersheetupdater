{
  "timezone": "Asia/Kolkata",
  "name": "dealer_objectives",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "dealership_id",
      "refers": "parents.dealership.dealership_id",
      "required": false
    },
    {
      "name": "dealership_idea_id",
      "refers": "parents.dealership_idea.dealership_idea_id",
      "required": false
    },
    {
        "name" : "dealership_name",
        "type" : "text"
    },
    {
      "name": "dealership_details",
      "type": "text",
      "required": false
    },
    {
      "name": "campaign_idea",
      "type": "text",
      "required": false
    },
    {
      "name": "ctas",
      "title": "Call to Actions",
      "type": "string_list",
      "list_type": "text",
      "ui_element": "tags"
    },
    {
      "name": "campaign_objective",
      "type": "text",
      "required": false
    },
    {
      "name": "campaign_description",
      "type": "text",
      "required": false
    },
    {
      "name": "campaign_tagline",
      "type": "text",
      "required": false
    },
    {
      "name": "campaign_offer",
      "type" :"text"
    },
    {
      "name": "campaign_tone",
      "type": "text"
    },
    {
      "name": "urgency_hook",
      "type": "list",
      "list_type": "text"
    },
    {
      "name": "idea",
      "type": "text",
      "ui_element": "textarea"
    },
    {
      "name": "attachments",
      "list_type": "text",
      "type": "string_list",
      "ui_element": "file",
      "constraint": {
        "function": "url_validator"
      },
      "converter": {
        "function": "url_converter"
      }
    },
    {
      "name": "custom_attributes",
      "type": "List",
      "required": false
    },
    {
      "name": "guidelines",
      "type": "text",
      "required": false
    },
    {
      "name": "channel",
      "type": "text",
      "required": false
    },
    {
        "name" : "language",
        "type" : "text",
        "default": "englsh"
    },
    {
        "name" : "status",
        "type" : "text"
    },
    {
      "name": "dealer_objectives_id",
      "type": "uid",
      "indexed": true,
      "id": true,
      "default": {
        "function": "name_to_id",
        "args": [
          "dealership_id",
          "dealership_name",
          "created"
        ],
        "kwargs": {
          "is_unique": true,
          "separator": "_",
          "skip_empty": true
        }
      },
      "auto_updater": true
    }

    ],
        "parents": [
        "dealership", "dealership_idea"
            
    ]
}