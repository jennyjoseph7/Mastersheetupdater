{
  "timezone": "Asia/Kolkata",
  "name": "post_sales_campaign",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "workshop_id",
      "refers": "parents.workshop.workshop_id",
      "required": true
    },
    {
      "name": "dealership_name",
      "refers": "parents.workshop.dealership_name"
    },
    {
      "name": "region_name",
      "refers": "parents.workshop.region_name"
    },
    {
      "name": "workshop_code",
      "refers": "parents.workshop.workshop_code"
    },
    {
      "name": "workshop_name",
      "refers": "parents.workshop.workshop_name"
    },
    {
      "name": "campaign_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "campaign_type",
      "type": "text",
      "default": "post-sales"
    },
    {
      "name": "campaign_user_source",
      "type": "nested_object",
      "required": true
    },
    {
      "name": "campaign_objective",
      "type": "list",
      "options": [
        "Post-Purchase Call",
        "Welcome Email / WhatsApp",
        "First-Service Reminder",
        "Accessory Suggestion",
        "Insurance / RSA Onboarding",
        "Scheduled Service Reminder",
        "Missed Service Follow-Up",
        "Seasonal Check-Up / Awareness",
        "AMC Renewal",
        "Warranty Expiry Offer",
        "Referral Program / Loyalty",
        "Birthday / Anniversary Offer",
        "Exclusive Member Event",
        "Post-Service Feedback (CSI / NPS)",
        "Customer Education / How-To",
        "Recall",
        "Recall Follow-Up Call / WhatsApp",
        "Recall Completion Confirmation"
      ],
      "option_others": true
    },
    {
      "name": "campaign_sub_type",
      "type": "list",
      "options": [
        "workshop awareness",
        "offers",
        "new accessories",
        "new procedures"
      ]
    },
    {
      "name": "campaign_objective_type",
      "type": "list",
      "options": [
        "lead volume",
        "budget based",
        "roi target"
      ]
    },
    {
      "name": "campaign_offer",
      "type": "text"
    },
    {
      "name": "campaign_description",
      "type": "text"
    },
    {
      "name": "start_date",
      "type": "number"
    },
    {
      "name": "end_date",
      "type": "number"
    },
    {
      "name": "channels",
      "type": "list",
      "options": [
        "rcs",
        "email",
        "web_chat",
        "web_chat_voice",
        "fb_chat",
        "insta_chat",
        "twitter_chat",
        "voice_phone",
        "whatsapp_chat",
        "whatsapp_voice_note",
        "whatsapp_voice_call",
        "zoom_bot",
        "ms_teams"
      ],
      "ui_element": "multiselect"
    },
    {
      "name": "languages",
      "default": "english",
      "type": "string_list",
      "option_others": true,
      "ui_element": "tags",
      "options": [
        "english",
        "hindi",
        "kannada",
        "telugu",
        "tamil",
        "malayalam",
        "odia",
        "bengali",
        "marathi",
        "gujarati",
        "bengali",
        "assamese",
        "punjabi",
        "spanish",
        "arabic"
      ]
    },
    {
      "name": "urgency_hook",
      "type": "text"
    },
    {
      "name": "ctas",
      "title": "Call to Actions",
      "type": "string_list",
      "list_type": "text",
      "ui_element": "tags"
    },
    {
      "name": "number_targeted",
      "type": "number"
    },
    {
      "name": "number_reached",
      "type": "number"
    },
    {
      "name": "number_contacted",
      "type": "number"
    },
    {
      "name": "number_engaged",
      "type": "number"
    },
    {
      "name": "number_converted",
      "type": "number"
    },
    {
      "name": "budget_allocated",
      "type": "number"
    },
    {
      "name": "actual_spent",
      "type": "number"
    },
    {
      "name": "conversion_rate_percent",
      "type": "number",
      "default": {
        "function": "divide_attributes",
        "args": [
          "number_converted",
          "number_contacted"
        ]
      }
    },
    {
      "name": "cost_per_lead",
      "type": "number",
      "default": {
        "function": "divide_attributes",
        "args": [
          "actual_spent",
          "number_converted"
        ]
      }
    },
    {
      "name": "campaign_status",
      "type": "text",
      "options": [
        "Planned",
        "Active",
        "Completed",
        "On Hold",
        "Cancelled"
      ]
    },
    {
      "name": "responsible_person",
      "type": "text"
    },
    {
      "name": "remarks",
      "type": "text"
    },
    {
      "default": {
        "function": "make_uuid3",
        "args": [
          "workshop_name",
          "campaign_name",
          "start_date",
          "campaign_type",
          "campaign_objective"
        ]
      },
      "name": "campaign_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "workshop"
  ]
}