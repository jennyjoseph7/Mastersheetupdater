                "function": "url_converter"
            },
            "constraint": {
                "function": "url_validator"
            },
            "ui_element": "file"
        },
        {
            "name": "vehicle_persona_summary",
            "type": "text"
        },
        {
            "name": "customer_score",
            "type": "number"
        },
        {
            "name": "status",
            "type": "text",
            "options": [
                "Active",
                "In Service",
                "Sold",
                "Scrapped",
                "Pending Transfer",
                "Inactive"
            ],
            "ui_element": "select"
        },
        {
            "name": "description",
            "type": "text"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "variant_name",
                    "variant_color_name",
                    "vin_number"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " - "
                }
            },
            "name": "vehicle_id",
            "type": "uid",
            "id": true
        }
