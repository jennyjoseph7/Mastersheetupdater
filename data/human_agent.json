{
    "name" : "human_agent",
    "timezone" : "Asia/Kolkata",
    "model_type": "default",
    "attributes" : [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name" : "human_agent_name",
            "type" : "name",
            "indexed" : true
        },
        {
            "name" : "email",
            "type" : "text"
        },
        {
            "name" : "role",
            "type" : "text"
        },
        {
            "name" : "active",
            "type" : "boolean"
        },
        {
            "name" : "availability",
            "type" : "boolean"
        },
        {
            "name" : "engagement_type",
            "type" : "text",
            "options" : [
                "call",
                "chat",
                "email"
            ]
        },
        {
            "name" : "human_agent_id",
            "type" : "uid",
            "id" : true,
            "auto_updater":true,
            "default" : {
                "function" : "name_to_id",
                "args": [
                    "human_agent_name",
                    "dealership_id"
                ],
                "kwargs" : {
                    "is_unique" : true,
                    "separator" : "_",
                    "skip_empty" : true
                }
            }
        }
    ],
    "parents" : [
        "dealership"
    ]
}