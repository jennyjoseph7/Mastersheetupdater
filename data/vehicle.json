{
    "timezone": "Asia/Kolkata",
    "name": "vehicle",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "variant_id",
            "type": "uid"
        },
        {
            "name": "variant_name",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "variant",
                    "variant_id",
                    "variant_name"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "variant_id"
        },
        {
            "name": "variant_full_name",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "variant",
                    "variant_id",
                    "variant_full_name"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "variant_id"
        },
        {
            "name": "variant_aliases",
            "type": "string_list",
            "default": {
                "function": "get_from_model",
                "args": [
                    "variant",
                    "variant_id",
                    "variant_aliases"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "variant_id"
        },
        {
            "name": "vehicle_model_id",
            "type": "uid",
            "default": {
                "function": "get_from_model",
                "args": [
                    "variant",
                    "variant_id",
                    "vehicle_model_id"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "variant_id"
        },
        {
            "name": "vehicle_model_name",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "variant",
                    "variant_id",
                    "vehicle_model_name"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "variant_id"
        },
        {
            "name": "vehicle_brand_id",
            "type": "uid",
            "default": {
                "function": "get_from_model",
                "args": [
                    "variant",
                    "variant_id",
                    "vehicle_brand_id"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "variant_id"
        },
        {
            "name": "vehicle_brand_name",
            "type": "uid",
