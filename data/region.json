{
  "timezone": "Asia/Kolkata",
  "name": "region",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "region_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "country_name",
      "type": "text"
    },
    {
      "name": "currency",
      "type": "text"
    },
    {
      "name": "region_level_guidelines",
      "type": "text"
    },
    {
      "name": "region_level_guardrails",
      "type": "text"
    },
    {
      "name": "timezones",
      "type": "text"
    },
    {
      "name": "date_format",
      "type": "text",
      "default": "%d-%m-%Y"
    },
    {
      "name": "region_guardrails",
      "type": "text"
    },
    {
      "auto_updater": true,
      "default": {
        "args": [
          "region_name"
        ],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": "-",
          "is_unique": true,
          "separator": "-",
          "case": "lower",
          "skip_empty": true
        }
      },
      "name": "region_id",
      "type": "uid",
      "id": true
    }
  ]
}