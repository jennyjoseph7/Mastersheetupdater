{
    "timezone": "Asia/Kolkata",
    "name": "variant_feature",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "is_standard",
            "type": "bool"
        },
        {
            "name": "is_engine_dependent",
            "type": "bool"
        },
        {
            "name": "is_transmission_dependent",
            "type": "bool"
        },
        {
            "name": "is_drivetrain_dependent",
            "type": "bool"
        },
        {
            "name": "variant_id",
            "refers": "parents.variant.variant_id"
        },
        {
            "name": "variant_name",
            "refers": "parents.variant.variant_name"
        },
        {
            "name": "feature_id",
            "refers": "parents.feature.feature_id"
        },
        {
            "name": "feature_name",
            "refers": "parents.feature.feature_name"
        },
        {
            "name": "feature_category",
            "refers": "parents.feature.feature_category"
        },
        {
            "name": "aliases",
            "refers": "parents.feature.aliases"
        },
        {
            "name": "feature_description",
            "refers": "parents.feature.feature_description"
        },
        {
            "name": "additional_cost",
            "refers": "parents.feature.additional_cost"
        },
        {
            "name": "additional_cost_unit",
            "refers": "parents.feature.additional_cost_unit"
        },
        {
            "name": "feature_type",
            "refers": "parents.feature.feature_type"
        },
        {
            "name": "availability_status",
            "type": "bool"
        },
        {
            "name": "feature_aliases",
            "refers": "parents.feature.aliases"
        },
        {
            "name": "images",
            "refers": "parents.feature.images"
        },
        {
            "name": "videos",
            "refers": "parents.feature.videos"
        },
        {
            "name": "feature_value",
            "type": "multi",
            "title": "Feature Value / Specification"
        },
        {
            "name": "unit_of_measure",
            "refers": "parents.feature.unit_of_measure"
        },
        {
            "name": "package_name",
            "type": "text",
            "title": "Package (If Applicable)"
        },
        {
            "name": "additional_cost",
            "type": "number",
            "units": "INR"
        },
        {
            "name": "launch_date",
            "type": "number"
        },
        {
            "name": "discontinuation_date",
            "type": "number"
        },
        {
            "name": "remarks",
            "type": "text"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "variant_name",
                    "feature_name"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " - "
                }
            },
            "name": "variant_feature_id",
            "type": "uid",
            "id": true
        }
    ],
    "parents": [
        "variant",
        "feature"
    ]
}
