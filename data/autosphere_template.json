                    "title",
                    "brand_id",
                    "vehicle_model_id",
                    "template_name",
                    "size",
                    "theme"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "is_unique": true,
                    "separator": "-",
                    "case": "lower",
