{
  "timezone": "Asia/Kolkata",
  "name": "variant_feature",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "variant_id",
      "refers": "parents.variant.variant_id"
    },
    {
      "auto_updater" :  true,
      "name": "variant_name",
      "refers": "parents.variant.variant_name"
    },
    {
      "name": "feature_id",
      "refers": "parents.feature.feature_id"
    },
    {
      "auto_updater" : true,
      "name": "feature_name",
      "refers": "parents.feature.feature_name"
    },
    {
      "auto_updater" :  true,
      "name": "feature_category",
      "refers": "parents.feature.feature_category"
    },
    {
      "name": "aliases",
      "refers": "parents.feature.aliases"
    },
    {
      "auto_updater" :  true,
      "name": "feature_description",
      "refers": "parents.feature.feature_description"
    },
    {
      "name": "additional_cost",
      "refers": "parents.feature.additional_cost"
    },
    {
      "name": "additional_cost_unit",
      "refers": "parents.feature.additional_cost_unit"
    },
    {
      "auto_updater" :  true,
      "name": "feature_category",
      "refers": "parents.feature.feature_category"
    },
    {
      "auto_updater" :  true,
      "name": "feature_type",
      "refers": "parents.feature.feature_type"
    },
    {
      "name": "showcase_image",
      "refers": "parents.feature.showcase_image"
    },
    {
      "name": "images",
      "refers": "parents.feature.images"
    },
    {
      "name": "videos",
      "refers": "parents.feature.videos"
    },
    {
      "auto_updater" :  true,
      "name": "feature_value",
      "type": "text",
      "title": "Feature Value"
    },
    {
      "auto_updater" :  true,
      "name": "unit_of_measure",
      "refers": "parents.feature.unit_of_measure"
    },
    {
      "name": "package_name",
      "type": "text",
      "title": "Package (If Applicable)"
    },
    {
      "name": "launch_date",
      "type": "number",
      "default": {
        "function": "now_ctime"
      },
      "auto_updater": true
    },
    {
      "name": "discontinuation_date",
      "type": "number",
      "default": {
        "function": "now_ctime"
      },
      "auto_updater": true
    },
    {
      "name": "remarks",
      "type": "text"
    },
    {
      "name": "status",
     "refers" : "parents.variant.variant_status"
    },
    {
      "auto_updater": true,
      "default": {
        "args": [
          "variant_name",
          "feature_name"
        ],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "variant_feature_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "variant",
    "feature"
  ]
}