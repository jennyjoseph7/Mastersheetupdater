{
            "timezone": "Asia/Kolkata",
            "name": "dealership",
            "model_type": "default",
            "attributes": [
                 {
                    "name": "created",
                    "type": "number",
                    "auto_updater": true,
                    "default": {
                        "function": "now_ctime"
                    }
                },
                {
                    "name": "updated",
                    "type": "number",
                    "auto_updater": true,
                    "force_update": true,
                    "default": {
                        "function": "now_ctime"
                    }
                },
                {
                    "name": "dealer_name",
                    "type": "name",
                    "indexed": true
                },
                {
                    "name": "dealer_group_id",
                    "refers":"parents.dealer_group.dealer_group_id",
                    "required": true
                },
                {
                    "name":"supported_brands",
                    "type":"list",
                    "ui_element":"multi_select",
                    "options":"options/brand/brand_name",
                    "required":false
                },
                {
                    "name":"region_id",
                    "refers":"parents.region.region_id",
                    "required": true
                },
                {
                    "name":"billing_id",
                    "refers":"parents.billing.billing_id",
                    "required": true
                },
                {
                    "name": "dealer_location",
                    "type": "geolocation"
                },
                {
                    "name": "dealer_address",
                    "type": "text"
                },
                {
                    "name": "dealer_phone_number",
                    "constraint":{
                        "function": "phone_validator"
                    },
                    "type": "text"
                },
                {
                    "name": "dealer_email",
                    "type": "text",
                    "constraint": {
                        "function": "email_validator"
                    }
                },
                {
                    "name": "dealer_status",
                    "type": "text",
                    "options": [
                        "active",
                        "inactive",
                        "suspended"
                    ],
                    "indexed": true
                },
                {
                    "name": "dealership_id",
                    "type": "uid",
                    "indexed": true,
                    "id": true,
                    "default": {
                        "function": "name_to_id",
                        "args":[
                            "dealer_name",
                            "region_id",
                            "brand_id"
                        ],
                        "kwargs":{
                            "is_unique":true,
                            "separator":"_",
                            "skip_empty":true
                        }
                    },
                    "auto_updater":true
                }
            ],
            "parents":[
                "dealer_group",
                "region"
            ]
        }