{
  "timezone": "Asia/Kolkata",
  "name": "region",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "region_code",
      "type": "text"
    },
    {
      "name": "region_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "country",
      "type": "text"
    },
    {
      "auto_updater": true,
      "default": {
        "args": ["region_code", "region_name"],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "region_id",
      "type": "uid",
      "id": true
    }
  ]
}
