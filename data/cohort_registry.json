{
  "name": "cohort_registry",
  "description": "Stores cohort definitions for a specific OEM and product. The cohort registry contains segmentation groups used for marketing, analytics, or lead assignment.",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },

    {
      "name": "oem_name",
      "type": "text",
      "indexed": true
    },

    {
      "name": "product_name",
      "type": "text",
      "indexed": true
    },

    {
      "name": "cohort_version",
      "type": "text"
    },

    {
      "name": "cohort_registry",
      "type": "nested_object"
    },

    {
      "name": "cohort_metadata",
      "type": "nested_object"
    },

    {
      "auto_updater": true,
      "default": {
        "args": ["oem_name", "product_name"],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": "-",
          "is_unique": true,
          "separator": "-"
        }
      },
      "name": "cohort_registry_id",
      "type": "uid",
      "id": true
    }
  ]
}