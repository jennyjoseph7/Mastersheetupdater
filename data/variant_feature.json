            "converter": {
                "function": "url_converter"
            }
        },
        {
            "name": "images",
            "refers": "parents.feature.images"
        },
        {
            "name": "videos",
            "refers": "parents.feature.videos"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "variant_name",
                    "feature_name"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "case": "lower",
                    "skip_empty": true,
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-"
                }
            },
            "name": "variant_feature_id",
            "type": "uid",
            "id": true
        },
        {
            "name": "information_status",
            "type": "text",
            "default": "unverified",
            "options": [
                "pending",
                "running",
                "unverified",
                "verified"
            ],
            "ui_element": "select"
        }
