            "type": "number",
            "default": 10
        },
        {
            "name": "on_contacted_trigger_id",
            "type": "uid",
            "option_others": true,
            "options": "/options/campaign_workflow/campaign_workflow_name"
        },
        {
            "name": "on_contacted_trigger",
            "type": "nested_object",
