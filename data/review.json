{
    "timezone": "Asia/Kolkata",
    "name": "review",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "showroom_visit_id",
            "refers": "parents.showroom_visit.showroom_visit_id"
        },
        {
            "name": "pre_sales_lead_id",
            "refers": "parents.showroom_visit.pre_sales_lead_id"
        },
        {
            "name": "user_id",
            "refers": "parents.showroom_visit.user_id"
        },
        {
            "name": "person_name",
            "refers": "parents.showroom_visit.person_name"
        },
        {
            "name": "phone_number",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "last_contacted_phone_number"
                ]
            },
            "indexed": true
        },
        {
            "name": "email",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "last_contacted_email"
                ]
            },
            "indexed": true
        },
        {
            "name": "whatsapp_number",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "last_contacted_whatsapp_number"
                ]
            },
            "indexed": true
        },
        {
            "name": "dealership_id",
            "refers": "parents.showroom_visit.dealership_id"
        },
        {
            "name": "dealership_name",
            "refers": "parents.showroom_visit.dealer_name",
            "indexed": true
        },
        {
            "name": "visit_date",
            "refers": "parents.showroom_visit.visit_date"
        },
        {
            "name": "overall_rating",
            "type": "number"
        },
        {
            "name": "description_of_showroom_experience",
            "type": "text"
        },
        {
            "name": "purpose_of_visit",
            "refers": "parents.showroom_visit.purpose_of_visit"
        },
        {
            "name": "showroom_name",
            "refers": "parents.showroom_visit.showroom_name"
        },
        {
            "name": "models_interested_in",
            "refers": "parents.showroom_visit.models_interested_in"
        },
        {
            "name": "variants_interested_in",
            "refers": "parents.showroom_visit.variants_interested_in"
        },
        {
            "name": "models_test_driven",
            "type": "string_list",
            "list_type": "text",
            "ui_element": "multiselect"
        },
        {
            "name": "services_received",
            "type": "string_list",
            "list_type": "text",
            "ui_element": "multiselect",
            "option_others": true,
            "options": [
                "Car Consultation",
                "Test Drive",
                "Vehicle Booking Assistance",
                "Finance Consultation",
                "Insurance Consultation",
                "Accessories Consultation",
                "Exchange Offer Discussion",
                "Registration Assistance",
                "Complaint / Feedback Resolution",
                "Customer Lounge",
                "Wi-Fi",
                "Cafe / Refreshments",
                "EV Charging",
                "Children Play Area",
                "Parking Facility",
                "Virtual Reality Experience",
                "Home Test Drive",
                "Extended Working Hours",
                "Weekend Service",
                "Festive Offers",
                "Other"
            ]
        },
        {
            "name": "visit_helped_in_decision",
            "type": "bool",
            "default": false
        },
        {
            "name": "able_to_make_a_decision",
            "type": "bool",
            "default": false
        },
        {
            "name": "competitor_brands_considered",
            "type": "string_list",
            "list_type": "text",
            "ui_element": "multiselect"
        },
        {
            "name": "likely_to_purchase_models",
            "type": "string_list",
            "list_type": "text",
            "ui_element": "multiselect"
        },
        {
            "name": "rating_overall",
            "type": "number",
            "title": "Overall Rating (1-5)",
            "constraint": {
                "min": 1,
                "max": 5
            },
            "ui_element": "rating"
        },
        {
            "name": "rating_staff_behavior",
            "type": "number",
            "title": "Staff Behavior Rating (1-5)",
            "constraint": {
                "min": 1,
                "max": 5
            },
            "ui_element": "rating"
        },
        {
            "name": "rating_showroom_experience",
            "type": "number",
            "title": "Showroom Experience Rating (1-5)",
            "constraint": {
                "min": 1,
                "max": 5
            },
            "ui_element": "rating"
        },
        {
            "name": "rating_home_test_drive_experience",
            "type": "number",
            "title": "Home Test Drive Experience Rating (1-5)",
            "constraint": {
                "min": 1,
                "max": 5
            },
            "ui_element": "rating"
        },
        {
            "name": "car_review_text",
            "type": "text",
            "title": "Review Comments",
            "ui_element": "textarea"
        },
        {
            "name": "media_attachments",
            "type": "list",
            "title": "Photos / Videos Attached (URLs)"
        },
        {
            "name": "emotions",
            "type": "list",
            "list_type": "text",
            "ui_element": "tags",
            "option_others": true,
            "options": [
                "Positive",
                "Neutral",
                "Negative",
                "Curious",
                "Angry",
                "Impressed",
                "Disinterested",
                "Disappointed",
                "Happy",
                "Surprised",
                "Excited",
                "Frustrated",
                "Satisfied",
                "Interested",
                "Confused",
                "Bored",
                "Sleepy",
                "Stressed",
                "Anxious"
            ],
            "converter": {
                "function": "make_title"
            }
        },
        {
            "name": "sentiment_score",
            "type": "number"
        },
        {
            "name": "propensity_scores",
            "type": "nested_object",
            "default": {
                "function": "get_from_model",
                "args": [
                    "pre_sales_lead",
                    "pre_sales_lead_id",
                    "propensity_scores"
                ]
            }
        },
        {
            "name": "response_status",
            "type": "text",
            "options": [
                "New",
                "Acknowledged",
                "Reviewed",
                "Action Taken",
                "Escalated",
                "Closed",
                "Rejected"
            ],
            "ui_element": "select"
        },
        {
            "name": "review_date",
            "type": "text"
        },
        {
            "name": "resolved_timestamp",
            "type": "number"
        },
        {
            "name": "review_status",
            "type": "text",
            "options": [
                "Active",
                "Flagged",
                "Hidden",
                "Archived"
            ],
            "ui_element": "select"
        },
        {
            "name": "review_tags",
            "type": "list",
            "title": "Tags / Keywords"
        },
        {
            "name": "remarks",
            "type": "text"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "showroom_name",
                    "phone_number",
                    "email",
                    "person_name",
                    "visit_date"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-",
                    "skip_empty": true
                }
            },
            "name": "review_id",
            "type": "uid",
            "id": true
        }
    ],
    "parents": [
        "showroom_visit"
    ]
}