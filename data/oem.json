{
  "name": "oem",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "oem_name",
      "type": "text",
      "indexed": true
    },

    {
      "name": "oem_country_of_origin",
      "type": "text"
    },
    {
      "name": "oem_headquarters",
      "type": "text"
    },
    {
      "name": "oem_logo_url",
      "type": "text",
      "constraint": {
        "function": "url_validator"
      },
     "converter": {
        "function": "url_converter"
      }
    },
    {
      "name": "oem_website_url",
      "type": "text"
    },
    {
        "name":"oem_brand_awareness",
        "type": "text"
    },
    {
        "name":"parent_company",
        "type": "text"
    },
    {
        "name":"oem_wiki_description",
        "type": "text"

    },
    {
        "name":"oem_vehicle_categories",
        "type": "list",
        "options":["Passenger vehicles", "Commercial Vehicles", "Two Wheelers", "Three Wheelers","Truck" , "Bus" ,"Electric Vehicles"]
    },
    {
      "auto_updater": true,
      "default": {
        "args": ["oem_name"],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "oem_id",
      "type": "uid",
      "id": true
    }
  ]
}
