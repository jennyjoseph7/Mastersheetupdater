{
    "name": "post_sales_lead",
    "model_type": "default",
    "parents": [
        "post_sales_campaign"
    ],
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "vehicle_id",
            "type": "uid",
            "required": true
        },
        {
            "name": "vehicle_brand",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_brand"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "vehicle_id"
        },
        {
            "name": "vehicle_model",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_model"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "vehicle_id"
        },
        {
            "name": "vehicle_variant",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_variant"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "vehicle_id"
        },
        {
            "name": "reg_number",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "reg_number"
                ]
            }
        },
        {
            "name": "vin_number",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "reg_number"
                ]
            }
        },
        {
            "name": "persons_involved",
            "type": "object_list",
            "dict_keys": [
                "user_id",
                "person_name",
                "last_contacted_whatsapp_number",
                "last_contacted_email",
                "last_contacted_phone_number"
            ],
            "auto_updater": true,
            "force_update": "vehicle_id",
            "default": {
                "function": "pivot_from_model",
                "args": [
                    "person_vehicle",
                    "vehicle_id",
                    "unique_object_list"
                ],
                "kwargs": {
                    "vehicle_id": "{vehicle_id}"
                }
            }
        },
        {
            "type": "number",
            "name": "customer_score"
        },
        {
            "name": "dealership_id",
            "type": "uid",
            "required": true
        },
        {
            "name": "dealer_name",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_name"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "dealer_location",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_location"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "dealer_address",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_address"
                ]
            },
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "campaign_id",
            "type": "uid",
            "required": false
        },
        {
            "name": "campaign_name",
            "refers": "parents.post_sales_campaign.campaign_name"
        },
        {
            "name": "campaign_type",
            "refers": "parents.post_sales_campaign.campaign_type"
        },
        {
            "name": "workshop_id",
            "type": "uid",
            "required": false
        },
        {
            "name": "workshop_name",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "workshop",
                    "workshop_id",
                    "workshop_name"
                ]
            },
            "auto_updater": true,
            "force_update": "workshop_id"
        },
        {
            "name": "workshop_address",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "workshop",
                    "workshop_id",
                    "address"
                ]
            },
            "auto_updater": true,
            "force_update": "workshop_id"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "vehicle_reg_number",
                    "dealership_name",
                    "campaign_name"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " - ",
                    "skip_empty": true
                }
            },
            "name": "post_sales_lead_id",
            "type": "uid",
            "id": true
        }
    ]
}