{
    "timezone": "Asia/Kolkata",
    "name": "variant_feature",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "feature_id",
            "refers": "parents.feature.feature_id"
        },
        {
            "name": "feature_name",
            "refers": "parents.feature.feature_name"
        },
        {
            "name": "feature_category",
            "refers": "parents.feature.feature_category"
        },
        {
            "name": "value_type",
            "refers": "parents.feature.value_type"
        },
        {
            "name": "unit",
            "refers": "parents.feature.unit"
        },
        {
            "name": "feature_aliases",
            "refers": "parents.feature.aliases"
        },
        {
            "name": "feature_type",
            "type": "text",
            "options": [
                "Standard",
                "Optional",
                "Add-On",
                "Package-only"
            ],
            "ui_element": "select"
        },
        {
            "name": "tags",
            "type": "string_list",
            "ui_element": "multiselect",
            "options": [
                "premium",
                "essential",
                "popular",
                "new",
                "limited",
                "electric",
                "safety",
                "luxury",
                "comfort"
            ],
            "option_others": true
        },
        {
            "name": "variant_id",
            "refers": "parents.variant.variant_id",
            "default": {
                "args": [
                    "vehicle_model_name",
                    "variant_name",
                    "engine_type",
                    "transmission_type",
                    "drivetrain"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "case": "lower",
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-",
                    "skip_empty": true
                }
            }
        },
        {
            "name": "variant_name",
            "refers": "parents.variant.variant_name"
        },
        {
            "name": "model_year_id",
            "refers": "parents.variant.model_year_id"
        },
        {
            "name": "vehicle_model_id",
            "refers": "parents.variant.vehicle_model_id"
