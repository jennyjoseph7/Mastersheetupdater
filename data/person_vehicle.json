{
    "timezone": "Asia/Kolkata",
    "name": "person_vehicle",
    "model_type": "default",
    "parents": [
        "person",
        "vehicle"
    ],
    "attributes": [
        {
            "name": "user_id",
            "refers": "parents.person.user_id",
            "indexed": true,
            "required": true
        },
        {
            "name": "person_name",
            "refers": "parents.person.name",
            "indexed": true
        },
        {
            "name": "last_contacted_whatsapp_number",
            "refers": "parents.person.last_contacted_whatsapp_number",
            "indexed": true
        },
        {
            "name": "last_contacted_email",
            "refers": "parents.person.last_contacted_email",
            "indexed": true
        },
        {
            "name": "last_contacted_phone_number",
            "refers": "parents.person.last_contacted_phone_number",
            "indexed": true
        },
        {
            "name": "vehicle_id",
            "refers": "parents.vehicle.vehicle_id",
            "indexed": true,
            "required": true
        },
        {
            "name": "relationship_type",
            "type": "text",
            "options": [
                "owner",
                "co_owner",
                "family_member",
                "friend",
                "driver",
                "finance_holder",
                "other"
            ],
            "indexed": true,
            "default": "owner"
        },
        {
            "name": "since",
            "type": "number"
        },
        {
            "name": "notes",
            "type": "text"
        },
        {
            "name": "created",
            "type": "datetime",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "datetime",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "person_vehicle_id",
            "type": "uid",
            "indexed": true,
            "id": true,
            "default": {
                "function": "name_to_id",
                "args": [
                    "user_id",
                    "vehicle_id",
                    "created"
                ],
                "kwargs": {
                    "is_unique": true,
                    "separator": "_",
                    "skip_empty": true,
                    "attribute_join": "-"
                }
            }
        }
    ]
}