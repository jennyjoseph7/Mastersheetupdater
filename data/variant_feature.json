{
  "timezone": "Asia/Kolkata",
  "name": "variant_feature",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "feature_type",
      "type": "text",
      "options": [
        "Standard",
        "Optional",
        "Add-On",
        "Package-only"
      ],
      "ui_element": "select"
    },
    {
      "name": "tags",
      "type": "string_list",
      "ui_element": "multiselect",
      "options": [
        "premium",
        "essential",
        "popular",
        "new",
        "limited",
        "electric",
        "safety",
        "luxury",
        "comfort"
      ],
      "option_others": true
    },
    {
      "name": "is_standard",
      "refers": "parents.feature.is_standard"
    },
    {
      "name": "is_engine_dependent",
      "refers": "parents.feature.is_engine_dependent"
    },
    {
      "name": "is_transmission_dependent",
      "refers": "parents.feature.is_transmission_dependent"
    },
    {
      "name": "is_drivetrain_dependent",
      "refers": "parents.feature.is_drivetrain_dependent"
    },
    {
      "name": "variant_id",
      "refers": "parents.variant.variant_id"
    },
    {
      "auto_updater": true,
      "name": "variant_name",
      "refers": "parents.variant.variant_name"
    },
    {
      "name": "feature_id",
      "refers": "parents.feature.feature_id"
    },
    {
      "auto_updater": true,
      "name": "feature_name",
      "refers": "parents.feature.feature_name"
    },
    {
      "auto_updater": true,
      "name": "feature_category",
      "refers": "parents.feature.feature_category"
    },
    {
      "name": "aliases",
      "type": "string_list",
      "converter": {
        "function": "ensure_in_list",
        "args": [
          "feature_name"
        ]
      }
    },
    {
      "auto_updater": true,
      "name": "feature_description",
      "refers": "parents.feature.feature_description"
    },
    {
      "name": "additional_cost_unit",
      "refers": "parents.feature.additional_cost_unit"
    },
    {
      "auto_updater": true,
      "name": "feature_value",
      "type": "text",
      "title": "Feature Value"
    },
    {
      "auto_updater": true,
      "type": "text",
      "name": "unit_of_measure"
    },
    {
      "name": "package_name",
      "type": "text",
      "title": "Package name"
    },
    {
      "name": "launch_date",
      "type": "number",
      "default": {
        "function": "now_ctime"
      },
      "auto_updater": true
    },
    {
      "name": "discontinuation_date",
      "type": "number"
    },
    {
      "name": "remarks",
      "type": "text"
    },
    {
      "name": "status",
      "refers": "parents.variant.variant_status"
    },
    {
      "name": "showcase_image",
      "type": "text",
      "constraint": {
        "function": "url_validator"
      },
      "converter": {
        "function": "url_converter"
      }
    },
    {
      "name": "images",
      "type": "list",
      "title": "Feature Images"
    },
    {
      "name": "videos",
      "type": "list",
      "title": "Feature Videos"
    },
    {
      "name": "additional_cost",
      "type": "number"
    },
    {
      "auto_updater": true,
      "default": {
        "args": [
          "variant_name",
          "feature_name"
        ],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "variant_feature_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "variant",
    "feature"
  ]
}