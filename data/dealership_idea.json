{
  "timezone": "Asia/Kolkata",
  "name": "dealership_idea",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "datetime",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "datetime",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "dealership_id",
      "refers": "parents.dealership.dealership_id",
      "indexed": true
    },
    {
      "name": "campaign_type",
      "type": "list",
      "options": [
        "pre-sales",
        "post-sales",
        "dealership"
      ],
      "default": "pre-sales"
    },
    {
      "name": "dealership_idea_id",
      "type": "uid",
      "indexed": true,
      "id": true,
      "default": {
        "function": "name_to_id",
        "args": [
          "dealership_id",
          "campaign_type",
          "created"
        ],
        "kwargs": {
          "is_unique": true,
          "separator": "_",
          "skip_empty": true
        }
      },
      "auto_updater": true
    },
    {
      "name": "campaign_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "campaign_objective",
      "type": "list",
      "options": [
        "Product Launch / Reveal",
        "Event Promotion",
        "Cold List Activation",
        "Event/Expo Data Activation",
        "Dormant CRM Reactivation",
        "Interest Confirmation & Qualification",
        "Profile Completion Campaign",
        "Dealer / OEM Offer Promotion",
        "Exchange / Loyalty Bonus Offer",
        "EMI / Finance Scheme Push",
        "Year-End / Stock Clearance",
        "New Variant / Feature Highlight",
        "Price Drop / Offer Re-Nudge",
        "Comparison / Decision Aid Campaign",
        "Test Drive Reminder / Showroom Visit Reminder / Follow-Up",
        "Accessory Promotion / Suggestion",
        "Insurance / Finance / RSA Add-On",
        "Upgrade Offer for Existing Owner",
        "Custom Campaign",
        "Post-Purchase Call",
        "Welcome Email / WhatsApp",
        "First-Service Reminder",
        "Scheduled Service Reminder",
        "Missed Service Follow-Up",
        "Seasonal Check-Up / Awareness",
        "AMC Renewal",
        "Warranty Expiry Offer",
        "Referral Program / Loyalty",
        "Birthday / Anniversary Offer",
        "Exclusive Member Event",
        "Post-Service Feedback (CSI / NPS)",
        "Customer Education / How-To",
        "Recall / Recall Follow-Up / Completion Confirmation"
      ],
      "option_others": true
    },
    {
      "name": "campaign_sub_type",
      "type": "list",
      "options": [
        "brand awareness",
        "product awareness",
        "event",
        "lead generation",
        "workshop awareness",
        "offers",
        "new accessories",
        "new procedures"
      ],
      "option_others": true
    },
    {
      "name": "campaign_objective_type",
      "type": "list",
      "options": [
        "lead volume",
        "budget based",
        "roi target"
      ]
    },
    {
      "name": "ctas",
      "title": "Call to Actions",
      "type": "string_list",
      "list_type": "text",
      "ui_element": "tags"
    },
    {
      "name": "campaign_offer",
      "type": "text"
    },
    {
      "name": "campaign_description",
      "type": "text"
    },
    {
      "name": "campaign_tone",
      "type": "text"
    },
    {
      "name": "campaign_tagline",
      "type": "text"
    },
    {
      "name": "urgency_hook",
      "type": "list",
      "list_type": "text"
    },
    {
      "name": "idea",
      "type": "text",
      "ui_element": "textarea"
    },
    {
      "name": "attachments",
      "list_type": "text",
      "type": "string_list",
      "ui_element": "file",
      "constraint": {
        "function": "url_validator"
      },
      "converter": {
        "function": "url_converter"
      }
    },
    {
      "name": "status",
      "type": "text",
      "options": [
        "new",
        "reviewing",
        "approved",
        "rejected"
      ],
      "indexed": true
    },
    {
      "name": "notes",
      "type": "text"
    }
  ],
  "parents": [
    "dealership"
  ]
}