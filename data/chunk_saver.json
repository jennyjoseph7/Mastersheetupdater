{
    "name": "chunk_saver",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "document_id",
                    "page_no",
                    "created"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-",
                    "case": "lower",
                    "skip_empty": true
                }
            },
            "id": true,
            "name": "chunk_id",
            "type": "uid"
        },
        {
            "name": "document_id",
            "type": "text",
            "required": true,
            "indexed": true
        },
        {
            "name": "title",
            "type": "text"
        },
        {
            "name": "heading",
            "type": "text",
            "indexed": true
        },
        {
            "name": "sub_heading",
            "type": "text"
        },
        {
            "name": "sub_sub_heading",
            "type": "text"
        },
        {
            "name": "text_content",
            "type": "text",
            "required": true
        },
        {
            "name": "page_no",
            "type": "number"
        },
        {
            "name": "page_split_no",
            "type": "number"
        },
        {
            "name": "page_image_url",
            "type": "text"
        },
        {
            "name": "images",
            "type": "object_list",
            "dict_keys": [
                "url",
                "caption"
            ]
        },
        {
            "name": "tables",
            "type": "object_list",
            "dict_keys": [
                "table_text",
                "table_summary",
                "table_image_url",
                "ref_id"
            ]
        },
        {
            "name": "hierarchy_path",
            "type": "nested_object"
        },
        {
            "name": "metadata",
            "type": "nested_object"
        },
        {
            "name": "question",
            "type": "string_list"
        },
        {
            "name": "keywords",
            "type": "string_list"
        }
    ]
}