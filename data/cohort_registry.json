{
  "name": "cohort_registry",
  "description": "Stores cohort definitions for a specific OEM and product. The cohort registry contains segmentation groups used for marketing, analytics, or lead assignment.",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },

    {
      "name": "brand_id",
      "refers": "parents.brand.brand_id"
    },

    {
      "name": "brand_name",
      "refers": "parents.brand.brand_name"
    },
    
    {
      "name" : "vehicle_model_id",
      "refers": "parents.vehicle_model.vehicle_model_id"
    },

    {
      "name" : "vehicle_model_name",
      "refers": "parents.vehicle_model.vehicle_model_name"
    },


    {
      "name": "cohort_version",
      "type": "text"
    },

    {
      "name": "cohort_registry",
      "type": "nested_object"
    },

    {
      "name": "cohort_metadata",
      "type": "nested_object"
    },

    {
      "auto_updater": true,
      "default": {
        "args": ["brand_name", "vehicle_model_name"],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": "-",
          "is_unique": true,
          "separator": "-",
          "suffix" : "-cohort_registry"
        }
      },
      "name": "cohort_registry_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": ["brand", "vehicle_model"]
}