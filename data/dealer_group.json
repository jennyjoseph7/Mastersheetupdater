{
    "timezone": "Asia/Kolkata",
    "name": "dealer_group",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "dealer_group_name",
            "type": "text",
            "indexed": true
        },
        {
            "name": "year_established",
            "type": "number"
        },
        {
            "name": "headquarters_city",
            "type": "text"
        },
        {
            "name": "headquarters_state",
            "type": "text"
        },
        {
            "name": "headquarters_country",
            "type": "text"
        },
        {
            "name":"dealer_group_location",
            "type":"geolocation"
        },
        {
            "name":"dealer_group_guidelines",
            "type":"text"
        },
        {
            "name":"dealer_group_description",
            "type":"text"
        },
        {
            "name": "operating_brands",
            "type": "list",
            "ui_element": "multiselect",
            "default": {
                "function": "pivot_from_model",
                "args": [
                    "brand",
                    "brand_name",
                    "unique_list"
                ]
                
            }
        },
        {
            "name": "showroom_center_count",
            "type": "number"
        },
        {
            "name": "workshop_center_count",
            "type": "number"
        },
        {
            "name":"buyback_center_count",
            "type": "number"
        },
        {
            "name": "regions",
            "type": "list",
            "ui_element": "multi_select",
            "default": {
                "function": "pivot_from_model",
                "args": [
                    "region",
                    "region_name",
                    "unique_list"
                ]
                
            }
        },
        {
            "name": "website",
            "type": "text",
            "constraint": {
                "function": "url_validator"
            }
        },
        {
            "name": "linkedin_url",
            "type": "text",
            "constraint": {
                "function": "url_validator"
            }
        },
        {
            "name": "primary_contact_name",
            "type": "text"
        },
        {
            "name": "primary_contact_role",
            "type": "text"
        },
        {
            "name": "primary_contact_email",
            "type": "text",
            "constraint": {
                "function": "email_validator"
            }
        },
        {
            "name": "primary_contact_phone",
            "type": "text",
            "constraint": {
                "function": "phone_validator"
            }
        },
        {   
            "name": "legal_entity_type",
            "type": "text",
            "options": ["pvt_ltd", "llp", "public_ltd", "partnership"]
        },
        {
            "name": "annual_revenue_inr",
            "type": "number"
        },
        {
            "name": "dms",
            "type": "text"
        },
        {
            "name": "crm",
            "type": "text"
        },
        {
            "name": "service_mgmt_tools",
            "type": "list"
        },
        {
            "name": "channels",
            "type": "list",
            "options": [
                "rcs",
                "email",
                "web_chat",
                "web_chat_voice",
                "fb_chat",
                "insta_chat",
                "twitter_chat",
                "voice_phone",
                "whatsapp_chat",
                "whatsapp_voice_note",
                "whatsapp_voice_call",
                "zoom_bot",
                "ms_teams"
            ],
            "ui_element": "multiselect"
        },
        {
            "name": "lqs",
            "type": "text"
        },
        {
            "name": "staff_strength",
            "type": "number"
        },
        {
            "name": "other_tools",
            "type": "list"
        },
        {
            "name": "crm_dms_integration_feasibility",
            "type": "text",
            "options": ["yes", "no", "partial"]
        },
        {
            "name": "leadership_team",
            "type": "list"
        },
        {
            "name": "group_notes",
            "type": "text"
        },
        {
            "name": "tags",
            "type": "string_list"
        },
        {
            "name": "status",
            "type": "text",
            "options": [
                "active",
                "inactive",
                "suspended"
            ],
            "indexed": true
        },
        {
            "name": "dealer_group_id",
            "type": "uid",
            "indexed": true,
            "id": true,
            "default": {
                "function": "make_uuid_timestamp"
            }
        }
    ]
}