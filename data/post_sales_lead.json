            }
        },
        {
            "name": "vehicle_id",
            "type": "uid",
            "required": true
        },
        {
            "name": "vehicle_brand",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_brand"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "vehicle_id"
        },
        {
            "name": "vehicle_model",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
