{
    "timezone": "Asia/Kolkata",
    "name": "billing_report",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "quick_select",
            "type": "text",
            "options": [
                "month",
                "week",
                "two_months",
                "three_months",
                "quarter",
                "year"
            ]
        },
        {
            "name": "start_date",
            "type": "text"
        },
        {
            "name": "end_date",
            "type": "text"
        },
        {
            "name": "start_timestamp",
            "type": "number"
        },
        {
            "name": "end_timestamp",
            "type": "number"
        },
        {
            "name": "dealership_id",
            "refers": "parents.dealership.dealership_id",
            "required": true
        },
        {
            "name": "dealer_name",
            "refers": "parents.dealership.dealer_name"
        },
        {
            "name": "total_billed_amount",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "total_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_tax",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "total_tax_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_amount",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "total_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_credits_remaining",
            "refers": "parents.dealership.credits_balance"
        },
        {
            "name": "total_credits_consumed",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "credit_balance_after",
                    "sum"
                ]
            }
        },
        {
            "name": "currency",
            "type": "text",
            "options": [
                "INR",
                "USD",
                "EUR",
                "GBP",
                "AED",
                "SAR",
                "JPY",
                "other"
            ],
            "default": "INR",
            "option_others": true
        },
        {
            "name": "total_gst",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "gst_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_sgst",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "sgst_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_cgst",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "cgst_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_vat",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "vat_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "invoice_url",
            "type": "text",
            "default": {
                "function": "generate_billing_invoice",
                "args": [
                    "billing"
                ]
            }
        },
        {
            "name": "billing_report_id",
            "type": "uid",
            "id": true,
            "default": {
                "function": "make_uuid3",
                "args": [
                    "dealership_id",
                    "start_timestamp",
                    "end_timestamp",
                    "created"
                ]
            },
            "auto_updater": true
        }
    ],
    "parents": [
        "dealership"
    ]
}