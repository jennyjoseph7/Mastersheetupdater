{
    "timezone": "Asia/Kolkata",
    "name": "billing",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            },
            "indexed": true
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            },
            "indexed": true
        },
        {
            "name": "transaction_date",
            "type": "text"
        },
        {
            "name": "transaction_type",
            "type": "text",
            "options": [
                "credit",
                "debit",
                "refund"
            ],
            "default": "debit",
            "indexed": true
        },
        {
            "name": "item_name",
            "type": "text",
            "required": true,
            "indexed": true,
            "options": [
                "call_connected",
                "call_completed",
                "message_delivered",
                "response_to_query",
                "credit_purchase"
            ]
        },
        {
            "name": "search_term",
            "type": "text",
            "indexed": true,
            "force_update": [
                "transaction_date",
                "transaction_type",
                "item_name",
                "campaign_id",
                "channel",
                "item_description",
                "billing_address",
                "billing_contact_name",
                "billing_contact_email",
                "billing_contact_phone",
                "status",
                "invoice_url"
            ],
            "auto_updater": true,
            "default": {
                "function": "name_to_id",
                "args": [
                    "transaction_date",
                    "transaction_type",
                    "item_name",
                    "campaign_id",
                    "channel",
                    "item_description",
                    "billing_address",
                    "billing_contact_name",
                    "billing_contact_email",
                    "billing_contact_phone",
                    "status",
                    "invoice_url"
                ],
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " ",
                    "skip_empty": true,
                    "case": "lower"
                }
            }
        },
        {
            "name": "campaign_id",
            "type": "text",
            "indexed": true,
            "default": "inbound"
        },
        {
            "name": "channel",
            "type": "text",
            "indexed": true
        },
        {
            "name": "item_description",
            "type": "text",
            "placeholder": "campaign type - campaign objective - campaign name - channel - provider - phone number or email"
        },
        {
            "name": "item_quantity",
            "type": "number",
            "default": 1
        },
        {
            "name": "item_units",
            "type": "text",
            "default": "count",
            "options": [
                "count",
                "seconds",
                "days",
                "minutes",
                "hours",
                "tokens",
                "1K_tokens",
                "1M_tokens",
                "100_words",
                "500_characters",
                "1K_characters",
                "1M_characters"
            ],
            "ui_element": "select"
        },
        {
            "name": "item_price",
            "type": "number",
            "required": true
        },
        {
            "name": "discount_percentage",
            "type": "number",
            "required": true,
            "default": 0
        },
        {
            "name": "item_final_price",
            "type": "number"
        },
        {
            "name": "item_total",
            "type": "number",
            "default": {
                "function": "multiply_attributes",
                "args": [
                    "item_quantity",
                    "item_price"
                ]
            }
        },
        {
            "name": "discount_amount",
            "type": "number"
        },
        {
            "name": "item_final_total",
            "type": "number"
        },
        {
            "name": "currency",
            "type": "text",
            "default": "credits",
            "options": [
                "credits",
                "INR",
                "USD",
                "EUR",
                "GBP",
                "AED",
                "SAR",
                "JPY"
            ],
            "option_others": true,
            "required": true
        },
        {
            "name": "dealership_id",
            "required": true,
            "indexed": true
        },
        {
            "name": "billing_address",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "billing_address"
                ]
            },
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "billing_contact_name",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "billing_contact_name"
                ]
            },
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "billing_contact_email",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "billing_contact_email"
                ]
            },
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "billing_contact_phone",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "billing_contact_phone"
                ]
            },
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "payment_mode",
            "type": "text",
            "options": [
                "upi",
                "net_banking",
                "credit_card",
                "debit_card",
                "bank_transfer",
                "wallet",
                "nft"
            ]
        },
        {
            "name": "payment_gateway",
            "type": "text",
            "options": [
                "razorpay",
                "stripe",
                "paypal",
                "cashfree",
                "manual"
            ]
        },
        {
            "name": "transaction_id",
            "type": "text",
            "default": {
                "function": "generate_transaction_id",
                "kwargs": {
                    "mode": "billing"
                }
            },
            "auto_updater": true,
            "indexed": true
        },
        {
            "name": "status",
            "type": "text",
            "options": [
                "initiated",
                "success",
                "failed",
                "refunded",
                "pending"
            ],
            "default": "initiated",
            "indexed": true
        },
        {
            "name": "invoice_url",
            "type": "text",
            "constraint": {
                "function": "url_validator"
            }
        },
        {
            "name": "gst_percentage",
            "type": "number"
        },
        {
            "name": "gst_amount",
            "type": "number"
        },
        {
            "name": "sgst_percentage",
            "type": "number"
        },
        {
            "name": "sgst_amount",
            "type": "number"
        },
        {
            "name": "cgst_percentage",
            "type": "number"
        },
        {
            "name": "cgst_amount",
            "type": "number"
        },
        {
            "name": "hsn_code",
            "type": "text"
        },
        {
            "name": "vat_percentage",
            "type": "number"
        },
        {
            "name": "vat_amount",
            "type": "number"
        },
        {
            "name": "total_tax_percentage",
            "type": "number"
        },
        {
            "name": "total_tax_amount",
            "type": "number"
        },
        {
            "name": "total_amount",
            "type": "number"
        },
        {
            "name": "credit_balance_before",
            "type": "number",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "credits_balance"
                ]
            }
        },
        {
            "name": "credit_balance_after",
            "type": "number",
            "default": {
                "function": "subtract_attributes",
                "args": [
                    "credit_balance_before",
                    "item_total"
                ]
            },
            "auto_updater": true,
            "force_update": [
                "credit_balance_before",
                "item_total"
            ]
        },
        {
            "name": "gst_number",
            "type": "text"
        },
        {
            "name": "vat_number",
            "type": "text"
        },
        {
            "name": "remarks",
            "type": "text"
        },
        {
            "name": "billing_id",
            "type": "uid",
            "indexed": true,
            "id": true,
            "default": {
                "function": "make_uuid3",
                "args": [
                    "dealership_id",
                    "item_name",
                    "item_description",
                    "item_quantity",
                    "transaction_date",
                    "created"
                ]
            },
            "auto_updater": true
        },
        {
            "name": "payment_object",
            "type": "nested_object"
        }
    ]
}
