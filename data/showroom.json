{
  "timezone": "Asia/Kolkata",
  "name": "showroom",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": { "function": "now_ctime" }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": { "function": "now_ctime" }
    },
    {
      "name": "dealership_id",
      "refers": "parents.dealership.dealership_id",
      "auto_updater": true
    },
    {
      "name": "dealership_name",
      "refers": "parents.dealership.dealership_name"
    },
    {
      "name": "brand_name",
      "refers": "parents.dealership.brand_name"
    },
    {
      "name": "region_name",
      "refers": "parents.dealership.region_name"
    },
    {
      "name": "showroom_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "showroom_code",
      "type": "text",
      "indexed": true
    },
    {
      "name": "showroom_type",
      "type": "text",
      "options": [
        "Main Showroom",
        "City Outlet",
        "Express Outlet",
        "Experience Center",
        "Mall Kiosk",
        "Virtual Showroom"
      ]
    },
    {
      "name": "contact_number",
      "type": "text"
    },
    {
      "name": "email",
      "type": "text"
    },
    {
      "name": "address",
      "type": "text"
    },
    {
      "name": "city",
      "type": "text"
    },
    {
      "name": "state",
      "type": "text"
    },
    {
      "name": "pincode",
      "type": "text"
    },
    {
      "name": "geolocation",
      "type": "geolocation"
    },
    {
      "name": "operating_hours",
      "type": "nested_object",
      "dict_keys": ["opening_time", "closing_time"]
    },
    {
      "name": "days_open",
      "type": "multi_select",
      "options": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ]
    },
    {
      "name": "manager_name",
      "type": "text"
    },
    {
      "name": "manager_contact",
      "type": "text"
    },
    {
      "name": "total_sales_executives",
      "type": "number"
    },
    {
      "name": "daily_walkin_capacity",
      "type": "number"
    },
    {
      "name": "facilities_available",
      "type": "multi_select",
      "options": [
        "Customer Lounge",
        "Wi-Fi",
        "Cafe / Refreshments",
        "Test Drive Zone",
        "Display Vehicles",
        "Finance Desk",
        "Insurance Desk",
        "Accessories Section",
        "EV Charging Point",
        "Children Play Area",
        "Parking Facility"
      ]
    },
    {
      "name": "parking_capacity",
      "type": "number"
    },
    {
      "name": "display_vehicle_count",
      "type": "number"
    },
    {
      "name": "virtual_tour_url",
      "type": "text"
    },
    {
      "name": "status",
      "type": "text",
      "options": ["Active", "Inactive", "Under Renovation"]
    },
    {
      "auto_updater": true,
      "default": {
        "args": [
          "dealership_name",
          "showroom_name",
          "city"
        ],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "showroom_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": ["dealership"]
}
