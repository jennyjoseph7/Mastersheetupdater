{
    "name":"campaign_dashboard",
    "model_type":"default",
    "attributes":[
      {
        "name": "created",
        "type": "number",
        "auto_updater": true,
        "default": {
          "function": "now_ctime"
        }
      },
      {
        "name": "updated",
        "type": "number",
        "auto_updater": true,
        "force_update": true,
        "default": {
          "function": "now_ctime"
        }
      },
      {
        "name": "workshop_name",
        "type": "text"
      },
      {
        "name": "campaign_objective",
        "type": "text"
      },
      {
        "name": "campaign_name",
        "type": "text",
        "required": true,
        "indexed": true
      },
      {
        "name": "campaign_type",
        "type": "text",
        "auto_updater": true,
        "default": "post-sales"
      },
      {
        "name": "start_date",
        "type": "number"
      },
      {
        "name": "channels",
        "type": "list",
        "options": [
          "rcs",
          "email",
          "web_chat",
          "web_chat_voice",
          "fb_chat",
          "insta_chat",
          "twitter_chat",
          "voice_phone",
          "whatsapp_chat",
          "whatsapp_voice_note",
          "whatsapp_voice_call",
          "zoom_bot",
          "ms_teams"
        ],
        "ui_element": "multiselect"
      },
      {
        "name": "languages",
        "default": "english",
        "type": "string_list",
        "option_others": true,
        "ui_element": "tags",
        "options": [
          "english",
          "hindi",
          "kannada",
          "telugu",
          "tamil",
          "malayalam",
          "odia",
          "bengali",
          "marathi",
          "gujarati",
          "bengali",
          "assamese",
          "punjabi",
          "spanish",
          "arabic"
        ]
      },
      {
        "name": "campaign_status",
        "type": "text",
        "options": ["Planned", "Active", "Completed", "On Hold", "Cancelled"]
      },
      {
        "name": "campaign_id",
        "type": "text",
        "required": true
      },
      {
        "default": {
          "function": "make_uuid3",
          "args": [
            "workshop_name",
            "campaign_id",
            "start_date",
            "campaign_name",
            "campaign_type",
            "campaign_objective"
          ]
        },
        "name": "campaign_dashboard_id",
        "type": "uid",
        "id": true
      }
    ]
}