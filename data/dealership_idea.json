 {
            "timezone": "Asia/Kolkata",
            "name": "dealership_idea",
            "model_type": "default",
            "attributes": [
                {
                "name": "dealership_idea_id",
                "type": "uid",
                "indexed": true,
                "id": true,
                "default": {
                    "function": "name_to_id",
                    "args": [
                        "dealership_id",
                        "created"
                    ],
                    "kwargs": {
                        "is_unique": true,
                        "separator": "_",
                        "skip_empty": true
                    }
                },
                "auto_updater": true
                },
                {
                    "name": "dealership_id",
                    "type": "parents.dealership.dealership_id",
                    "indexed": true
                },
                {
                    "name": "idea",
                    "type": "text"
                },
                {
                    "name": "attachments",
                    "type": "file"
                },
                {
                    "name": "status",
                    "type": "text",
                    "options": [
                        "new",
                        "reviewing",
                        "approved",
                        "rejected"
                    ],
                    "indexed": true
                },
                {
                    "name": "notes",
                    "type": "text"
                },
                {
                    "name": "created",
                    "type": "datetime",
                    "auto_updater": true,
                    "default": {
                        "function": "now_ctime"
                    }
                },
                {
                    "name": "updated",
                    "type": "datetime",
                    "auto_updater": true,
                    "force_update": true,
                    "default": {
                        "function": "now_ctime"
                    }
                }
            ]
        }