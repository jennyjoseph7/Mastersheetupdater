{
    "name": "campaign_workflow",
    "attributes": [
        {
            "name": "campaign_type",
            "type": "text",
            "required": true,
            "indexed": true,
            "options": [
                "pre-sales",
                "post-sales",
                "dealership"
            ]
        },
        {
            "name": "campaign_model",
            "type": "text",
            "options": [
                "pre_sales_campaign",
                "post_sales_campaign",
                "dealership_campaign"
            ],
            "auto_updater": true,
            "force_update": [
                "campaign_id"
            ],
            "default": {
                "function": "attribute_mapper",
                "args": [
                    "campaign_type",
                    null
                ],
                "kwargs": {
                    "pre-sales": "pre_sales_campaign",
                    "post-sales": "post_sales_campaign",
                    "dealership": "dealership_campaign"
                }
            }
        },
        {
            "name": "campaign_objective_id",
            "type": "uid",
            "required": true,
            "indexed": true
        },
        {
            "name": "campaign_objective_name",
            "type": "text",
            "force_update": [
                "campaign_objective_id"
            ],
            "auto_updater": true,
            "default": {
                "function": "get_from_model",
                "args": [
                    "campaign_objective",
                    "campaign_objective_id",
                    "campaign_objective_name"
                ]
            }
        },
        {
            "name": "dealership_id",
            "type": "uid",
            "force_update": [
                "campaign_objective_id"
            ],
            "default": {
                "function": "get_from_model",
                "args": [
                    "campaign_objective",
                    "campaign_objective_id",
                    "dealership_id",
                    "dave"
                ]
            }
        },
        {
            "name": "dealership_name",
            "type": "uid",
            "force_update": [
                "campaign_objective_id"
            ],
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_name"
                ]
            }
        },
        {
            "name": "channel",
            "type": "text",
            "indexed": true,
            "required": true,
            "options": [
                "rcs",
                "whatsapp",
                "email",
                "web_chat",
                "web_chat_voice",
                "fb_chat",
                "insta_chat",
                "twitter_chat",
                "voice_phone",
                "whatsapp_chat",
                "whatsapp_voice_note",
                "whatsapp_voice_call",
                "zoom_bot",
                "ms_teams"
            ]
        },
        {
            "name": "campaign_workflow_stage",
            "type": "text",
            "options": [
                "queued",
                "attempted",
                "reached",
                "contacted",
                "engaged",
                "converted",
                "failed",
                "error"
            ],
            "option_others": true
        },
        {
            "name": "campaign_workflow_id",
            "id": true,
            "type": "uid",
            "default": {
                "function": "make_uuid3",
                "args": [
                    "campaign_type",
                    "channel",
                    "campaign_objective_id",
                    "campaign_workflow_stage"
                ]
            }
        },
        {
            "name": "campaign_workflow_name",
            "type": "text",
            "force_update": [
                "channel",
                "campaign_objective",
                "campaign_workflow_stage"
            ],
            "default": {
                "function": "name_to_id",
                "args": [
                    "campaign_type",
                    "channel",
                    "campaign_objective_name",
                    "campaign_workflow_stage",
                    "dealership_name"
                ],
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " ",
                    "skip_empty": true,
                    "case": "title"
                }
            }
        },
        {
            "name": "communication_credentials",
            "type": "text",
            "default": {
                "function": "search_in_model",
                "args": [
                    "communication_credential"
                ],
                "kwargs": {
                    "channel": "{channel}",
                    "dealership_id": "{dealership_id}"
                }
            }
        },
        {
            "name": "language",
            "type": "text",
            "default": "english",
            "option_other": true,
            "options": [
                "english",
                "hindi",
                "kannada",
                "telugu",
                "tamil",
                "malayalam",
                "odia",
                "bengali",
                "marathi",
                "gujarati",
                "bengali",
                "assamese",
                "punjabi",
                "spanish",
                "arabic"
            ],
            "ui_element": "select"
        },
        {
            "name": "template_id",
            "type": "text"
        },
        {
            "name": "template_type",
            "type": "text",
            "options": [
                "text",
                "media",
                "carousel",
                "form"
            ],
            "ui_element": "select"
        },
        {
            "name": "template_text",
            "type": "text",
            "ui_element": "textarea"
        },
        {
            "name": "template_variables",
            "type": "string_list",
            "list_type": "text",
            "ui_element": "tags"
        },
        {
            "name": "template_buttons_payload",
            "type": "list"
        },
        {
            "name": "template_media_id",
            "type": "text"
        },
        {
            "name": "media_file_name",
            "type": "text"
        },
        {
            "name": "template_media_type",
            "type": "text"
        },
        {
            "name": "template_media_url",
            "type": "text"
        },
        {
            "name": "template_payload",
            "type": "text"
        },
        {
            "name": "retries",
            "type": "number",
            "default": 0
        },
        {
            "name": "delay",
            "type": "number",
            "default": 10
        },
        {
            "name": "delay_type",
            "type": "text",
            "default": "constant",
            "options": [
                "constant",
                "linear",
                "exponential"
            ],
            "ui_element": "select"
        },
        {
            "name": "trigger_id",
            "type": "uid",
            "option_others": true,
            "options": [
                "switch_to_next_credential",
                "switch_to_next_channel",
                "follow_up_contact",
                "confirmation_message"
            ]
        },
        {
            "name": "trigger",
            "type": "nested_object",
            "dict_keys": [
                "task",
                "service",
                "kwargs",
                "args"
            ]
        }    
    ]
}