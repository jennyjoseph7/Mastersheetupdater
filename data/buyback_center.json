{
    "timezone": "Asia/Kolkata",
    "name": "buyback_center",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "inspection_date",
            "force_update": true,
            "type": "datetime"
        },
        {
            "name": "approval_date",
            "force_update": true,
            "type": "datetime"
        },
        {
            "name": "completion_date",
            "force_update": true,
            "type": "datetime"
        },
        { "name": "workshop_id", "refers": "parents.workshop.workshop_id" },

        {
            "name": "dealership_id",
            "refers": "parents.dealership.dealership_id",
            "auto_updater": true
        },
        {
            "name": "dealership_name",
            "refers": "parents.dealership.dealership_name"
        },
        {
            "name": "brand_name",
            "refers": "parents.dealership.brand_name"
        },
        {
            "name": "region_name",
            "refers": "parents.dealership.region_name"
        },
        {
            "name": "type",
            "type": "text",
            "options": [
                "Customer Return",
                "Test Drive Return",
                "Loaner Return",
                "Service Return",
                "Exchange Return",
                "Vehicle Replacement",
                "Lease Return",
                "Other"
            ],
            "ui_element": "select",
            "indexed": true
        },
        {
            "name": "reason",
            "type": "text",
            "options": [
                "End of Test Drive",
                "End of Service",
                "End of Lease",
                "Replacement Requested",
                "Complaint Resolution",
                "Accident Case",
                "Customer Unsatisfied",
                "Other"
            ],
            "ui_element": "select"
        },
        {
            "name": "return_date",
            "type": "datetime",
            "auto_updater": true
        },
        {
            "name": "odometer",
            "type": "number",
            "units": "km"
        },
        {
            "name": "fuel_level",
            "type": "number",
            "units": "litres"
        },
        {
            "name": "vehicle_condition",
            "type": "text",
            "options": [
                "Excellent",
                "Good",
                "Minor Scratches",
                "Moderate Damage",
                "Major Damage"
            ],
            "ui_element": "select"
        },
        {
            "name": "condition_description",
            "type": "text",
            "title": "Detailed Condition Notes"
        },
        {
            "name": "images_at_return",
            "type": "list",
            "title": "Images Captured at Return"
        },
        {
            "name": "inspected_by",
            "type": "text",
            "title": "Inspection Staff Name"
        },
        {
            "name": "verified_by",
            "type": "text",
            "title": "Return Verified By"
        },
        {
            "name": "next_action",
            "type": "text",
            "options": [
                "Ready for Next Customer",
                "Send to Workshop",
                "Clean and Inspect",
                "Send to OEM",
                "Return to Fleet",
                "Dispose or Replace"
            ],
            "ui_element": "select"
        },
        {
            "name": "estimated_repair_cost",
            "type": "number",
            "units": "INR",
            "title": "Estimated Repair Cost (if any)"
        },
        {
            "name": "repair_required",
            "type": "boolean",
            "default": false
        },
        {
            "name": "remarks",
            "type": "text"
        },
        {
            "name": "return_status",
            "type": "text",
            "options": [
                "Pending Inspection",
                "Inspected",
                "Approved",
                "Completed",
                "Rejected"
            ],
            "ui_element": "select",
            "indexed": true
        },
        {
            "name": "pickup_required",
            "type": "bool",
            "default": false,
            "ui_element": "switch"
        },
        {
            "name": "pickup_location",
            "type": "text",
            "ui_element": "textarea"
        },
        {
            "name": "type_of_pickup_mode",
            "type": "text",
            "options": [
                "In-Person",
                "Home Pickup",
                "Third-Party Courier",
                "OEM Logistic"
            ],
            "ui_element": "select"
        },
        {
            "name": "return_acknowledgement_number",
            "type": "text",
            "title": "System/Manual Acknowledgement ID"
        },
        {
            "name": "inspection_report_url",
            "type": "text",
            "ui_element": "file",
            "title": "Upload Inspection Report"
        },
        {
            "name": "refund_amount",
            "type": "number",
            "title": "Refund Amount (if applicable)"
        },
        {
            "name": "customer_feedback",
            "type": "text",
            "ui_element": "textarea",
            "title": "Customer Feedback on Return Process"
        },
        {
            "name": "quality_check_passed",
            "type": "bool",
            "default": false,
            "title": "Quality Check Passed after Return"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "vehicle_reg_number",
                    "return_date",
                    "return_type"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " - "
                }
            },
            "name": "return_id",
            "type": "uid",
            "id": true
        }
    ],
    "parents": [
        "oem",
        "brand",
        "model",
        "variant",
        "vehicle",
        "dealership",
        "person"
    ]
}