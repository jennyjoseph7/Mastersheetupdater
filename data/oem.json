{
  "name": "oem",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "oem_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "oem_code",
      "type": "text",
      "indexed": true
    },
    {
      "name": "country_of_origin",
      "type": "text"
    },
    {
        "name":"headquarters",
        "type":"text"
    },
    {
        "name": "logo_url",
        "type":"link"
    },
    {
      "name": "website_url",
      "type": "text"
    },
    {
        "name":"email",
        "type":"text"   
    },
    {
        "name":"phone",
        "type":"text"
    },
    {
        "auto_updater": true,
        "default": {
            "args": [
                "oem_code",
                "oem_name"
            ],
            "function": "name_to_id",
            "kwargs": {
                "attribute_join": " ",
                "is_unique": true,
                "separator": " - "
            }
        },
        "name": "oem_id",
        "type": "uid",
        "id": true
    }
  ]
}
