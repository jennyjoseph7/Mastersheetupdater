{
    "timezone": "Asia/Kolkata",
    "name": "feature",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "is_standard",
            "type": "bool"
          },
          {
            "name":"likely_to_recommend",
            "type":"bool"
          },
          {
            "name": "is_engine_dependent",
            "type": "bool"
          },
          {
            "name": "is_transmission_dependent",
            "type": "bool"
          },
          {
            "name": "is_drivetrain_dependent",
            "type": "bool"
          },
        {
            "name": "feature_category",
            "type": "text",
            "options": [
                "general",
                "branding_and_looks",
                "safety_and_environment",
                "comfort_and_convenience",
                "technology_and_performance",
                "infotainment_and_connectivity",                
                "others"
            ],
            "ui_element": "select",
            "indexed": true
        },
        {
            "name": "feature_name",
            "type": "text",
            "indexed": true
        },


        {
            "name": "feature_description",
            "type": "text",
            "ui_element": "textarea"
        },

        {
            "name": "unit",
            "type": "text",
            "required": false,

            "options":[
                "mm",
                "cm",
                "m",
                "inch",
                "ft",
              
                "litre",
                "ml",
                "gallon_us",
                "gallon_uk",
              
                "kg",
                "g",
                "ton",
              
                "hp",
                "bhp",
                "ps",
                "kw",
              
                "Nm",
                "lb_ft",
              
                "sec",
                "ms",
              
                "kmph",
                "mph",
              
                "km",
                "mile",
              
                "kWh",
                "Wh",
                "Ah",
                "V",
              
                "deg",
                "percent",
              
                "other"
              ],              
            "ui_element": "select"
        },
        {
            "name": "value_type",
            "type": "text",
            "options": [
                "number",
                "category",
                "boolean",
                "description"
            ],
            "ui_element": "select"
        },

        {
            "name": "additional_cost_unit",
            "type": "list",
            "options": [
                "INR",
                "USD",
                "EUR",
                "GBP",
                "JPY",
                "AED",
                "AUD",
                "CAD",
                "CNY",
                "CHF",
                "SGD",
                "HKD",
                "THB",
                "NZD",
                "KRW",
                "ZAR"
              ],
              "option_others": true

              
        },

    {
        "auto_updater": true,
        "default": {
          "args": ["feature_category","feature_name","value","unit"],
          "function": "name_to_id",
          "kwargs": {
            "attribute_join": " ",
            "is_unique": true,
            "separator": " - "
          }
        },
        "name": "feature_id",
        "type": "uid",
        "id": true
      },
        {
            "name":"replacement",
            "type" :"string_list",
            "placeholder" : "feature_ids list that can replace this feature"
        }
    ]
}