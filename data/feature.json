{
    "timezone": "Asia/Kolkata",
    "name": "feature",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "feature_category",
            "type": "text",
            "options": [
                "general",
                "branding_and_looks",
                "safety_and_environment",
                "comfort_and_convenience",
                "technology_and_performance",
                "infotainment_and_connectivity",
                "others"
            ],
            "ui_element": "select",
            "indexed": true
        },
        {
            "name": "feature_name",
            "type": "text",
            "indexed": true
        },
        {
            "name": "aliases",
            "type": "string_list",
            "converter": {
                "function": "ensure_in_list",
                "args": [
                    "feature_name"
                ]
            }
        },
        {
            "name": "feature_description",
            "type": "text",
            "ui_element": "textarea"
        },
        {
            "name": "unit",
            "type": "text",
            "required": false,
            "option_others": true,
            "options": [
                "mm",
                "cm",
                "m",
                "inch",
                "ft",
                "litre",
                "ml",
                "gallon_us",
                "gallon_uk",
                "kg",
                "g",
                "ton",
                "hp",
                "bhp",
                "ps",
                "kw",
                "Nm",
                "lb_ft",
                "sec",
                "ms",
                "kmph",
                "mph",
                "km",
                "mile",
                "kWh",
                "Wh",
                "Ah",
                "V",
                "deg",
                "percent",
                "other"
            ],
            "ui_element": "select"
        },
        {
            "name": "value_type",
            "type": "text",
            "indexed": true,
            "options": [
                "number",
                "category",
                "boolean",
                "description"
            ],
            "ui_element": "select"
        },
        {
            "name": "showcase_image",
            "type": "text",
            "constraint": {
                "function": "url_validator"
            },
            "converter": {
                "function": "url_converter"
            }
        },
        {
            "name": "images",
            "type": "list",
            "title": "Feature Images"
        },
        {
            "name": "videos",
            "type": "list",
            "title": "Feature Videos"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "feature_category",
                    "feature_name",
                    "value_type",
                    "unit"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "case": "lower",
                    "skip_empty": true,
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-"
                }
            },
            "name": "feature_id",
            "type": "uid",
            "id": true
        }
    ]
}