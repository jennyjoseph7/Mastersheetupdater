{
  "timezone": "Asia/Kolkata",
  "name": "model_year",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "vehicle_model_id",
      "refers": "parents.vehicle_model.model_id",
      "auto_updater": true
    },
    {
      "name": "vehicle_model_name",
      "refers": "parents.vehicle_model.model_name"
    },
    {
      "name": "brand_id",
      "auto_updater": true,
      "refers": "parents.vehicle_model.brand_id"
    },
    {
      "name": "brand_name",
      "refers": "parents.vehicle_model.brand_name"
    },
    {
      "name": "oem_id",
      "auto_updater": true,
      "refers": "parents.vehicle_model.oem_id"
    },
    {
      "name": "oem_name",
      "refers": "parents.vehicle_model.oem_name"
    },
    {
      "name": "fuel_types",
      "type": "list",
      "options":["Petrol", "Diesel", "CNG", "Electric", "Hybrid", "LPG", "Hydrogen"],
      "default": {
        "function": "get_from_model",
        "args": [
          "vehicle_model",
          "vehicle_model_id",
          "fuel_types"
        ]
      }
    },
    {
        "name":"transmission_types",
        "type":"list",
        "options":["Automatic", "Clutchless Manual", "Manual", "CVT", "DCT", "Other"],
        "default": {
          "function": "get_from_model",
          "args": [
            "vehicle_model",
            "vehicle_model_id",
            "transmission_types"
          ]
        }
    },
    {
        "name":"year_launched",
        "refers": "parents.vehicle_model.year_launched"
    },
    {
      "name": "year",
      "type": "number",
      "indexed": true
    },
    {
      "name": "discontinuation_date",
      "type": "number"
    },
    {
      "name": "year_label",
      "type": "text"
    },
    {
      "name": "price_range",
      "type": "nested_object",
      "dict_keys": [
        "min_price",
        "max_price"
      ]
    },
    {
      "name": "facelift",
      "type": "boolean",
      "default": false
    },
    {
      "name": "facelift_description",
      "type": "text"
    },
    {
      "name": "major_changes",
      "type": "multiselect",
      "options": [
        "Exterior Design Update",
        "Interior Update",
        "Engine Upgrade",
        "Safety Feature Update",
        "Infotainment Update",
        "Variant Restructure",
        "facelift",
        "Other"
      ]
    },
    {
      "name": "year_status",
      "type": "text",
      "options": [
        "Active",
        "Discontinued",
        "Upcoming"
      ]
    },
    {
      "name": "remarks",
      "type": "text"
    },
    {
      "auto_updater": true,
      "default": {
        "args": [
          "brand_name",
          "model_name",
          "year"
        ],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "model_year_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "vehicle_model"
  ]
}