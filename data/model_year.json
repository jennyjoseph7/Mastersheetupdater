{
  "timezone": "Asia/Kolkata",
  "name": "model_year",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "vehicle_model_id",
      "refers": "parents.vehicle_model.vehicle_model_id"
    },
    {
      "name": "vehicle_model_generic_name",
      "refers": "parents.vehicle_model.vehicle_model_name"
    },
    {
      "name": "brand_id",
      "refers": "parents.vehicle_model.brand_id"
    },
    {
      "name": "brand_name",
      "refers": "parents.vehicle_model.brand_name"
    },
    {
      "name": "region_id",
      "refers": "parents.vehicle_model.region_id"
    },
    {
      "name": "region_name",
      "refers": "parents.vehicle_model.region_name"
    },
    {
      "name": "country_name",
      "refers": "parents.vehicle_model.country_name"
    },
    {
      "name": "region_level_guidelines",
      "refers": "parents.vehicle_model.region_level_guidelines"
    },
    {
      "name": "region_level_guardrails",
      "refers": "parents.vehicle_model.region_level_guardrails"
    },
    {
      "name": "vehicle_category",
      "refers": "parents.vehicle_model.vehicle_category"
    },
    {
      "name": "vehicle_type",
      "refers": "parents.vehicle_model.vehicle_type"
    },
    {
      "name": "brand_logo_url",
      "refers": "parents.vehicle_model.brand_logo_url"
    },
    {
      "name": "brand_website",
      "refers": "parents.vehicle_model.brand_website"
    },
    {
      "name": "parent_company",
      "refers": "parents.vehicle_model.parent_company"
    },
    {
      "name": "brand_level_guidelines",
      "refers": "parents.vehicle_model.brand_level_guidelines"
    },
    {
      "name": "brand_level_guardrails",
      "refers": "parents.vehicle_model.brand_level_guardrails"
    },
    {
      "name": "oem_id",
      "refers": "parents.vehicle_model.oem_id"
    },
    {
      "name": "oem_name",
      "refers": "parents.vehicle_model.oem_name"
    },
    {
      "name": "oem_brand_awareness",
      "refers": "parents.vehicle_model.oem_brand_awareness"
    },
    {
      "name": "oem_country_of_origin",
      "refers": "parents.vehicle_model.oem_country_of_origin"
    },
    {
      "name": "oem_wiki_description",
      "refers": "parents.vehicle_model.oem_wiki_description"
    },
    {
      "name": "brochure_pdf",
      "type": "text",
      "constraint": {
        "function": "url_validator"
      },
      "converter": {
        "function": "url_converter"
      },
      "ui_element": "file"
    },
    {
      "name": "brochure_download_link",
      "type": "text",
      "constraint": {
        "function": "url_validator"
      },
      "converter": {
        "function": "url_converter"
      },
      "ui_element": "url"
    },
    {
      "name": "vehicle_model_name",
      "type": "text",
      "indexed": true,
      "default": {
        "function": "name_to_id",
        "args": ["vehicle_model_generic_name","year"],
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      }
    },
    {
      "name": "vehicle_model_aliases",
      "type": "string_list",
      "converter": {
        "function": "ensure_in_list",
        "args": [
          "vehicle_model_generic_name",
          "vehicle_model_name"
        ]
      }
    },
    {
      "name": "engine_types",
      "type": "list",
      "options":["Petrol", "Diesel", "CNG", "Electric", "Hybrid", "LPG", "Hydrogen"],
      "default": {
        "function": "get_from_model",
        "args": [
          "vehicle_model",
          "vehicle_model_id",
          "engine_types"
        ]
      }
    },
    {
        "name":"transmission_types",
        "type":"list",
        "options":["Automatic", "Clutchless Manual", "Manual", "CVT", "DCT", "Other"],
        "default": {
          "function": "get_from_model",
          "args": [
            "vehicle_model",
            "vehicle_model_id",
            "transmission_types"
          ]
        }
    },
    {
        "name":"year_launched",
        "refers": "parents.vehicle_model.year_launched"
    },
    {
      "name": "year",
      "type": "number",
      "indexed": true
    },
    {
      "name": "discontinuation_date",
      "type": "number"
    },
    {
      "name": "year_label",
      "type": "text"
    },
    {
      "name": "price_range",
      "type": "nested_object",
      "dict_keys": [
        "min_price",
        "max_price"
      ]
    },
    {
      "name": "facelift",
      "type": "bool",
      "default": false
    },
    {
      "name": "facelift_description",
      "type": "text"
    },
    {
      "name": "major_changes",
      "type": "string_list",
      "list_type": "multiselect",
      "option_others": true,
      "options": [
        "Exterior Design Update",
        "Interior Update",
        "Engine Upgrade",
        "Safety Feature Update",
        "Infotainment Update",
        "Variant Restructure",
        "facelift",
        "Other"
      ],
      "ui_element": "multiselect"
    },
    {
      "name": "year_status",
      "type": "text",
      "options": [
        "Active",
        "Discontinued",
        "Upcoming"
      ]
    },
    {
      "name": "remarks",
      "type": "text"
    },
    {
      "name" : "feature_summary",
      "type" : "text",
      "default" : {
        "function" : "get_from_model",
        "args" : [
          "vehicle_model",
          "vehicle_model_id",
          "feature_summary"
        ]
      }
    },
    {
      "auto_updater": true,
      "default": {
        "args": [
          "brand_name",
          "vehicle_model_name",
          "year"
        ],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": "-",
          "is_unique": true,
          "separator": "-"
        }
      },
      "name": "model_year_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "vehicle_model"
  ]
}