{
    "timezone": "Asia/Kolkata",
    "name": "paragraph",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name" : "keywords",
            "type" : "string_list",
            "indexed": true
        },
        {
            "name": "paragraph_text",
            "type": "text"
        },
        {
            "required":true,
            "name":"document_id",
            "refers":"parents.document.document_id"
        },
        {
            "required":false,
            "name":"document_description",
            "refers":"parents.document.document_description"
        },
        {
            "required":false,
            "name":"document",
            "refers":"parents.document.document"
        },
        {
            "name":"document_tags",
            "refers":"parents.document.document_tags"
        },
        {
            "name":"brand_affiliations",
            "refers":"parents.document.brand_affiliations"
        },
        {
            "name":"oem_affiliations",
            "refers":"parents.document.oem_affiliations"
        },
        {
            "name":"dealership_affiliations",
            "refers":"parents.document.dealership_affiliations"
        },
        {
            "name":"vehicle_affiliations",
            "refers":"parents.document.vehicle_affiliations"
        },
        {
            "name":"model_year_affiliations",
            "refers":"parents.document.model_year_affiliations"
        },
        {
            "name":"variant_affiliations",
            "refers":"parents.document.variant_affiliations"
        },
        {
            "auto_updater":true,
            "force_update":[
                "document_id"
            ],
            "name": "document_name",
            "type": "text",
            "default":{
                "function":"get_from_model",
                "args":[
                    "document",
                    "document_id",
                    "document_name"
                ]
            }
        },
        {
            "required": false,
            "name": "title",
            "type": "text"
        },
        {
            "required": false,
            "name": "heading",
            "type": "text"
        },
        {
            "required": false,
            "name": "sub_heading",
            "type": "text"
        },
        {
            "required": false,
            "name": "sub_sub_heading",
            "type": "text"
        },
        {
            "required": true,
            "name": "paragraph",
            "type": "text"
        },
        {
            "required": false,
            "name": "questions",
            "type": "text"
        },
        {
            "required": false,
            "name": "summary",
            "type": "text"
        },
        {
            "required":false,
            "name":"row_id",
            "type":"text"
        },
        {
            "required":false,
            "name":"post_doc",
            "type":"bool",
            "placeholder" : "Have to check with balaji for the purpose of this attr"
        },
        {
            "required":false,
            "name":"synced",
            "type":"bool"
        },
        {
            "required": false,
            "name": "collection_name",
            "type": "text"
        },
        {
            "required":false,
            "name":"images",
            "type":"list"
        },
        {
            "name":"paragraph_id",
            "type":"uid",
            "id":true,
            "auto_updater":true,
            "default":{
                "function":"make_uuid3",
                "args":[
                    "document_id",
                    "sequence_num",
                    "created"
                ]
            }
        },
        {   
            "required":true,
            "name":"to_be_deleted",
            "type":"bool",
            "default":false
        }

    ],
    "parents" : [
        "document"
    ]
}