{
  "timezone": "Asia/Kolkata",
  "name": "pre_sales_campaign",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "showroom_id",
      "refers": "parents.showroom.showroom_id",
      "required": false
    },
    {
      "name": "dealership_id",
      "refers": "parents.dealership.dealership_id",
      "default": {
        "function": "get_from_model",
        "args": [
          "showroom",
          "showroom_id",
          "dealership_id"
        ]
      },
      "required": true,
      "force_update": "showroom_id"
    },
    
    {
      "name": "dealership_name",
      "refers": "parents.dealership.dealer_name"
    },
    {
      "name": "region_name",
      "refers": "parents.dealership.region_name"
    },
    {
      "name": "showroom_name",
      "type": "text",
      "default": {
        "function": "get_from_model",
        "args": [
          "showroom",
          "showroom_id",
          "showroom_name"
        ]
      },
      "auto_updater": true,
      "force_update": "showroom_id",
      "indexed": true
    },
    {
      "name": "showroom_full_name",
      "default": {
        "function": "get_from_model",
        "args": [
          "showroom",
          "showroom_id",
          "showroom_full_name"
        ]
      },
      "auto_updater": true,
      "force_update": "showroom_id",
      "indexed": true
    },
    {
      "name": "region_id",
      "refers": "parents.dealership.region_id"
    },
    {
      "name": "region_name",
      "refers": "parents.dealership.region_name"
    },
    {
      "name": "region_level_guidelines",
      "refers": "parents.dealership.region_level_guidelines"
    },
    {
      "name": "region_level_guardrails",
      "refers": "parents.dealership.region_level_guardrails"
    },
    {
      "name": "supported_brands",
      "refers": "parents.dealership.supported_brands"
    },
    {
      "name": "supported_brands_guidelines",
      "refers": "parents.dealership.supported_brands_guidelines"
    },
    {
      "name": "showroom_level_guidelines",
      "refers": "parents.showroom.showroom_level_guidelines"
    },
    {
      "name": "showroom_level_guardrails",
      "refers": "parents.showroom.showroom_level_guardrails"
    },
    {
      "name": "campaign_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "campaign_type",
      "type": "text",
      "default": "pre-sales"
    },
    {
      "name": "campaign_user_source",
      "type": "nested_object",
      "required": true
    },
    {
      "name": "campaign_objective_id",
      "type": "uid",
      "options": "/options/campaign_objective/campaign_objective_name",
      "option_others": true
    },
    {
      "name": "campaign_objective_name",
      "type": "text",
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "campaign_objective_name"
        ]
    },
    {
      "name": "campaign_objective_description",
      "type": "text",
      "title": "Campaign Objective Description",
      "default": {
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "campaign_objective_description"
        ]
      }
    },
    {
      "name": "conversation_tone",
      "type": "text",
      "default": {
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "conversation_tone"
        ]
      }
    },
    {
      "name": "campaign_objective_type",
      "type": "list",
      "options": ["lead volume", "budget based", "roi target"]
    },
    {
      "name": "campaign_custom_attributes",
      "type": "object_list",
      "list_type": "nested_object",
      "dict_keys": [
        "attribute_name",
        "attribute_value",
        "attribute_type",
        "attribute_description"
      ]
    },
    {
      "name": "campaign_sub_type",
      "default": {
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "campaign_sub_type"
        ]
      },
      "type": "text",
      "option_others": true
    },
    {
      "name": "campaign_guardrails_guidelines",
      "type": "text",
      "title": "Campaign Guardrails and Guidelines",
      "default": {
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "guardrails_guidelines"
        ]
      }
    },
    {
      "name": "why_user_should_avail_this",
      "type": "text",
      "title": "Why User Should Avail This",
      "default": {
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "why_user_should_avail_this"
        ]
      }
    },
    {
      "name": "reasons_users_may_not_be_interested",
      "type": "text",
      "default": {
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "reasons_users_may_not_be_interested"
        ]
      }
    },
    {
      "name": "reasons_for_non_applicability",
      "type": "text",
      "default": {
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "reasons_for_non_applicability"
        ]
      }
    },
    {
      "name": "other_important_information",
      "type": "text",
      "default": {
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "other_important_information"
        ]
      }
    },
    {
      "name": "campaign_description",
      "type": "text"
    },
    {
      "name": "start_date",
      "type": "number"
    },
    {
      "name": "end_date",
      "type": "number"
    },
    {
      "name": "channels",
      "refers": "parents.dealership.channels"
    },
    {
      "name": "languages",
      "default": "english",
      "type": "string_list",
      "option_others": true,
      "ui_element": "tags",
      "options": [
        "english",
        "hindi",
        "kannada",
        "telugu",
        "tamil",
        "malayalam",
        "odia",
        "bengali",
        "marathi",
        "gujarati",
        "bengali",
        "assamese",
        "punjabi",
        "spanish",
        "arabic"
      ]
    },
    {
      "name": "urgency_hook",
      "type": "text"
    },
    {
      "name": "ctas",
      "title": "Call to Actions",
      "options": [
        "know-more",
        "register-to-event",
        "book-test-drive",
        "book-showroom-visit",
        "download-brochure",
        "book-home-test-drive",
        "get-onroad-price",
        "request-callback"
      ],
      "option_others": true,
      "type": "string_list",
      "list_type": "text",
      "ui_element": "tags"
    },
    {
      "name": "campaign_offer",
      "type": "text",
      "title": "Campaign Offer"
    },
    {
      "name": "offer_applicability",
      "type": "text",
      "title": "Offer Applicability"
    },
    {
      "name": "number_targeted",
      "type": "number"
    },
    {
      "name": "number_reached",
      "type": "number"
    },
    {
      "name": "number_contacted",
      "type": "number"
    },
    {
      "name": "number_engaged",
      "type": "number"
    },
    {
      "name": "number_converted",
      "type": "number"
    },
    {
      "name": "budget_allocated",
      "type": "number"
    },
    {
      "name": "actual_spent",
      "type": "number"
    },
    {
      "name": "conversion_rate_percent",
      "type": "number",
      "default": {
        "function": "divide_attributes",
        "args": ["number_converted", "number_contacted"]
      }
    },
    {
      "name": "cost_per_lead",
      "type": "number",
      "default": {
        "function": "divide_attributes",
        "args": ["actual_spent", "number_converted"]
      }
    },
    {
      "name": "campaign_status",
      "type": "text",
      "options": ["Planned", "Active", "Completed", "On Hold", "Cancelled"]
    },
    {
      "name": "responsible_person",
      "type": "text"
    },
    {
      "name": "remarks",
      "type": "text"
    },
    {
      "default": {
        "function": "make_uuid3",
        "args": [
          "dealership_name",
          "campaign_name",
          "start_date",
          "campaign_type",
          "campaign_objective"
        ]
      },
      "name": "campaign_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "dealership",
    "showroom"
  ]
}