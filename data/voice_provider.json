{
    "name": "voice_provider",
    "attributes": [
        {
            "name": "voice_provider_name",
            "type": "text",
            "required": true,
            "indexed": true
        },
        {
            "name": "voice_provider_id",
            "id": true,
            "type": "uid",
            "auto_updater": true,
            "default": {
                "function": "make_uuid3",
                "args": [
                    "voice_provider_name"
                ]
            }
        },
        {
            "name": "credentials",
            "type": "nested_object"
        },
        {
            "name": "voice_provider_tags",
            "type": "list",
            "list_type": "text"
        },
        {
            "name": "cost",
            "type": "number"
        },
        {
            "name": "costing_units",
            "type": "number",
            "default": "seconds"
        },
        {
            "name": "cost_currency",
            "default": "USD",
            "type": "text"
        }
    ]
}
