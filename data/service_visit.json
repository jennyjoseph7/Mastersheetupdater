{
    "timezone": "Asia/Kolkata",
    "name": "service_visit",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "service_date",
            "type": "number",
            "auto_updater": true,
            "placeholder": "Service Date",
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "placeholder": "Updated",

            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "vehicle_id",
            "refers": "parents.vehicle.vehicle_id"
        },
        {
            "name": "vehicle_variant_name",
            "refers": "parents.vehicle.variant_name"
        },
        {
            "name": "vehicle_model_id",
            "refers": "parents.vehicle.vehicle_model_id"
        },
        {
            "name": "vehicle_model_name",
            "refers": "parents.vehicle.vehicle_model_name"
        },
        {
            "name": "vehicle_brand_id",
            "refers": "parents.vehicle.vehicle_brand_id"
        },
        {
            "name": "vehicle_brand_name",
            "refers": "parents.vehicle.vehicle_brand_name"
        },
        {
            "name": "dealership_id",
            "refers": "parents.dealership.dealership_id"
        },
        {
            "name": "dealership_name",
            "refers": "parents.dealership.dealership_name"
        },
        {
            "name": "service_visit_id",
            "atype": "unicode",
            "auto_updater": false,
            "converter": {
                "function": "to_unicode"
            },
            "type":"uid",
            "indexed": true,
            "id": true
        },
        {
            "name": "workshop_id",
        
            "refers": "parents.workshop.workshop_id",
            
            "indexed": true
        },
        {
            "name": "vehicle_id",
            "refers": "parents.vehicle_model.vehicle_model_id",

            "indexed": true
        },


        {
            "atype": "stringlist",

            "name": "issues_reported",
            "placeholder": "Issues Reported",

            "type": "list"
        },
        {
            "name": "services_performed",
            "type": "list",
            "atype": "stringlist",

            "placeholder": "Services Performed"

        },

        {
            "name": "tags",
            "type": "nested_object",
            "placeholder":"Tags"
        },
        {
            "name": "status",
            "type": "text",
            "options": [
                "pending",
                "scheduled",
                "in_progress",
                "completed",
                "cancelled"
            ],
            "indexed": true,
            "placeholder": "Status"
        }
    ],
    "parents": [
        "vehicle",
        "post_sales_lead"
    ]

}