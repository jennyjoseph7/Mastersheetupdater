{
    "name" : "human_agent",
    "timezone" : "Asia/Kolkata",
    "model_type": "default",
    "attributes" : [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name" : "agent_name",
            "type" : "name",
            "required": true,
            "indexed" : true
        },
        {
            "name": "phone_number",
            "type": "text",
            "constraint": {
                "function": "phone_validator"
            },
            "indexed": true
        },
        {
            "name" : "email",
            "type" : "text",
            "constraint": {
                "function": "email_validator"
            },
            "indexed": true
        },
        {
            "name" : "role",
            "type" : "text",
            "options": [
                "Workshop Manager",
                "Relationship Manager",
                "Sales Executive",
                "Service Executive",
                "Customer Support Executive",
                "Marketing Executive",
                "Other"
            ],
            "option_others": true
        },
        {
            "name" : "active",
            "type" : "boolean",
            "default": true
        },
        {
            "name" : "engaged",
            "type" : "boolean",
            "default" : false
        },
        {
            "name" : "availability",
            "type" : "nested_object",
            "dict_keys": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
        },
        {
            "name" : "channels",
            "type" : "string_list",
            "options" : [
                "rcs",
                "email",
                "web_chat",
                "web_chat_voice",
                "fb_chat",
                "insta_chat",
                "twitter_chat",
                "voice_phone",
                "whatsapp_chat",
                "whatsapp_voice_note",
                "whatsapp_voice_call",
                "zoom_bot",
                "ms_teams"
            ],
            "ui_element": "multiselect"
        },
        {
            "name": "password",
            "type": "password",
            "required": true,
            "default": {
                "function": "make_view_id",
                "kwargs": {
                    "make_unique": false
                }
            }
        },
        {
            "name" : "human_agent_id",
            "type" : "uid",
            "id" : true,
            "auto_updater":true,
            "default" : {
                "function" : "name_to_id",
                "args": [
                    "agent_name",
                    "dealership_id"
                ],
                "kwargs" : {
                    "is_unique" : false,
                    "separator" : "_",
                    "skip_empty" : true
                }
            }
        }
    ],
    "parents" : [
        "dealership"
    ],
    "has_login": true
}