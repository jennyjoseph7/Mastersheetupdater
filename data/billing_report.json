{
    "timezone": "Asia/Kolkata",
    "name": "dealership",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name":"quick_select",
            "type":"text",
            "options":[
                "month",
                "week",
                "two_months",
                "three_months",
                "quarter",
                "year"
            ]
        },
        {
            "name":"start_date",
            "type":"text"
        },
        {
            "name":"end_date",
            "type":"text"
        },
        {
            "name":"start_date",
            "type":"number"
        },
        {
            "name":"end_date",
            "type":"number"
        },

        {
            "name":"dealership_id",
            "refers":"parents.dealership.dealership_id",
            "required":true
        },
        {
            "name": "dealer_name",
            "refers": "parents.dealership.dealership_name"
        },
        {
            "name":"total_billed_amount",
            "type":"number",
            "default":{
                "function":"calulate_total_billing",
                "args":[
                    "billing",
                    "total_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_tax",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "total_tax_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_amount",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "total_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_credits_consumed",
            "refers":"parents.dealership.credits_balance"
            
        },
        {
            "name": "total_credits_remaining",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "credit_balance_after",
                    "sum"
                ]
            }
        },
        {
            "name": "currancy",
            "type": "string",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "currency",
                    "first"
                ]
            }
        },
        {
            "name": "total_gst",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "gst_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_sgst",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "sgst_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_cgst",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "cgst_amount",
                    "sum"
                ]
            }
        },
        {
            "name": "total_vat",
            "type": "number",
            "default": {
                "function": "calulate_total_billing",
                "args": [
                    "billing",
                    "vat_amount",
                    "sum"
                ]
            }
        },

        {
            "name":"generate_invoice",
            "type":"text",
            "default":{
                "function":"generate_billing_invoice",
                "args":["billing"]
            }
        }
   
    ],

    "parents": ["dealership" ]
}