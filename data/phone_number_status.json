{
    "name": "phone_number_status",
    "attributes": [
        {
            "name": "phone_number",
            "type": "text",
            "indexed": true,
            "required": true
        },
        {
            "name": "country_code",
            "type": "text",
            "indexed": true
        },
        {
            "name": "region_id",
            "type": "uid",
            "indexed": true
        },
        {
            "name": "region_name",
            "type": "text",
            "indexed": true
        },
        {
            "name": "channel",
            "type": "text",
            "options": [
                "voice_phone",
                "whatsapp_chat",
                "whatsapp_voice_note",
                "whatsapp_voice_call",
                "zoom_bot",
                "ms_teams"
            ],
            "required": true,
            "indexed": true
        },
        {
            "name": "phone_number_id",
            "id": true,
            "type": "uid",
            "indexed": true,
            "default": {
                "function": "make_uuid3",
                "args": [
                    "phone_number",
                    "channel"
                ]
            }
        },
        {
            "name": "status",
            "type": "text",
            "default": "queued",
            "options": ["error", "failed", "attempted", "reached", "contacted", "engaged", "converted"]
        },
        {
            "name": "attempts",
            "type": "number",
            "default": 0
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        }
    ]
}