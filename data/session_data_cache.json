{
    "timezone": "Asia/Kolkata",
    "name": "session_data_cache",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "user_id",
            "type": "uid",
            "indexed": true,
            "required" : true
        },
        {
            "name" : "session_id",
            "type" : "text",
            "required" : true,
            "indexed" : true
        },
        {
            "name" : "history",
            "type" : "object_list"
        }
    ]
}