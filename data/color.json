{
  "timezone": "Asia/Kolkata",
  "name": "color",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "brand_id",
      "refers": "parents.brand.brand_id"
    },
    {
      "name": "brand_name",
      "refers": "parents.brand.brand_name"
    },
    {
      "name": "color_name",
      "type": "text",
      "indexed": true  
    },
    {
      "name": "hex_code",
      "type": "text"
    },
    {
      "name": "rgb_code",
      "type": "text"
    },
    {
      "name": "finish_type",
      "type": "text",
      "options": ["Metallic", "Matte", "Pearl", "Solid"],
      "ui_element": "select"
    },
    {
      "name": "texture",
      "type": "text"
    },
    {
      "name": "image_url",
      "type": "text",
      "ui_element": "image"
    },
    {
      "name": "additional_cost",
      "type": "number"
    },
    {
      "name": "availability_status",
      "type": "text",
      "options": ["Available", "Limited", "Discontinued"],
      "ui_element": "select"
    },
    {
      "name": "color_status",
      "type": "text",
      "options": ["Active", "Inactive"],
      "ui_element": "select"
    },
    {
      "auto_updater": true,
      "default": {
        "args": ["brand_name", "color_name", "finish_type"],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": " ",
          "is_unique": true,
          "separator": " - "
        }
      },
      "name": "color_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": ["oem", "brand"]
}
