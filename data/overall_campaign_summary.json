        "default": {
          "function": "now_ctime"
        }
      },
      {
        "name": "updated",
        "type": "number",
        "auto_updater": true,
        "force_update": true,
        "default": {
          "function": "now_ctime"
        }
      },
      {
        "name":"campaign_type",
        "type": "text"
      },
      {
        "name": "active_count",
        "type": "number"
      },
      {
        "name": "total_count",
        "type": "number"
      },
      {
        "name": "total_reach",
        "type": "number"
      },
      {
        "name": "conversation_rate",
        "type": "number"
      },
      {
        "name": "campaign_summary_id",
        "type": "uid",
        "id": true,
        "default": {
          "function": "make_uuid3",
          "args": ["campaign_type"]
        }
      }
    ]
}