{
    "timezone": "Asia/Kolkata",
    "name": "service_visit",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "service_date",
            "type": "number",
            "auto_updater": true,
            "placeholder": "Service Date",
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name" : "odometer_reading",
            "type" : "number",
            "required" : false


        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "placeholder": "Updated",
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "post_sales_lead_id",
            "refers": "parents.post_sales_lead.post_sales_lead_id",
            "required": false
        },
        {
            "name": "vehicle_id",
            "refers": "parents.post_sales_lead.vehicle_id",
            "default": {
                "function": "get_from_model",
                "args": [
                    "post_sales_lead",
                    "post_sales_lead_id",
                    "vehicle_id"
                ]
            },
            "indexed": true,
            "required": true
        },
        {
            "name": "workshop_id",
            "refers": "parents.workshop.workshop_id",
            "required": true,
            "indexed": true,
            "default": {
                "function": "get_from_model",
                "args": [
                    "post_sales_lead",
                    "post_sales_lead_id",
                    "workshop_id"
                ]
            }
        },
        {
            "name": "dealership_id",
            "refers": "parents.workshop.dealership_id"
        },
        {
            "name": "dealer_name",
            "refers": "parents.workshop.dealer_name"
        },
        {
            "name": "vehicle_model_id",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_model_id"
                ]
            },
            "indexed": true,
            "force_update": "post_sales_lead_id"
        },
        {
            "name": "vehicle_model_name",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_model_name"
                ]
            },
            "indexed": true,
            "force_update": "post_sales_lead_id"
        },
        {
            "name": "vehicle_brand_id",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_brand_id"
                ]
            },
            "indexed": true,
            "force_update": "post_sales_lead_id"
        },
        {
            "name": "vehicle_brand_name",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_brand_name"
                ]
            },
            "indexed": true,
            "force_update": "post_sales_lead_id"
        },
        {
            "name": "vehicle_variant_id",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "variant_id"
                ]
            },
            "indexed": true,
            "force_update": "post_sales_lead_id"
        },
        {
            "name": "vehicle_variant_name",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "variant_name"
                ]
            },
            "indexed": true,
            "force_update": "post_sales_lead_id"
        },
        {
            "name": "vehicle_variant_full_name",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "variant_full_name"
                ]
            },
            "indexed": true,
            "force_update": "post_sales_lead_id"
        },
        {
            "name": "workshop_name",
            "refers": "parents.post_sales_lead.workshop_name"
        },
        {
            "name": "region_id",
            "refers": "parents.post_sales_lead.region_id"
        },
        {
            "name": "region_name",
            "refers": "parents.post_sales_lead.region_name"
        },
        {
            "name": "user_id",
            "type": "uid",
            "default": {
                "function": "search_in_model",
                "args": [
                    "person_vehicle",
                    "vehicle_id"
                ]
            }
        },
        {
            "name": "person_name",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "person_name"
                ]
            }
        },
        {
            "name": "phone_number",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "last_contacted_phone_number"
                ]
            },
            "indexed": true
        },
        {
            "name": "email",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "last_contacted_email"
                ]
            },
            "indexed": true
        },
        {
            "name": "whatsapp_number",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "last_contacted_whatsapp_number"
                ]
            },
            "indexed": true
        },
        {
            "name": "appointment_date",
            "type": "text"
        },
        {
            "name": "appointment_time",
            "type": "text"
        },
        {
            "name": "visit_date",
            "type": "text"
        },
        {
            "name": "visit_timestamp",
            "type": "number"
        },
        {
            "name": "purpose_of_visit",
            "type": "string_list",
            "list_type": "text",
            "ui_element": "multiselect",
            "option_others": true,
            "options": [
                "Free Service",
                "Paid Service",
                "General Service",
                "Inspection",
                "Repair",
                "Body Shop",
                "Body Work / Denting",
                "Paint Work",
                "Paint Protection",
                "Engine Service",
                "Brakes Service",
                "Transmission / Gearbox Service",
                "AC / HVAC Service",
                "Electrical Work / Components Service",
                "Battery Service",
                "Battery Replacement",
                "Tyre Work",
                "Tyre Replacement",
                "Wheel Alignment / Balancing",
                "Suspension / Shock Absorber Service",
                "Steering System Service",
                "Exhaust / Emission System Service",
                "Fuel System Service",
                "Cooling / Radiator System Service",
                "Interior Cleaning / Detailing",
                "Exterior Polishing / Paint Protection",
                "Lighting / Headlamp Service",
                "Wiper / Washer System Service",
                "Sensor / Electronics Calibration",
                "Software / ECU Update",
                "Navigation / Infotainment Update",
                "Recall Action",
                "Accessories Installation / Replacement",
                "General Health Check-up",
                "Preventive Maintenance",
                "Emission / Pollution Test",
                "Oil Change",
                "Oil Filter Change",
                "Insurance Claim",
                "Warranty Claim",
                "Pickup",
                "Drop",
                "Roadside Assistance",
                "Spare Parts",
                "Charging",
                "Other"
            ]
        },
        {
            "name": "service_visit_id",
            "atype": "unicode",
            "auto_updater": true,
            "default": {
                "function": "name_to_id",
                "args": [
                    "dealer_name",
                    "workshop_name",
                    "appointment_date",
                    "appointment_time",
                    "purpose_of_visit"
                ],
                "kwargs": {
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-",
                    "skip_empty": true,
                    "case": "lower"
                }
            },
            "type": "uid",
            "id": true
        },
        {
            "atype": "stringlist",
            "name": "issues_reported",
            "placeholder": "Issues Reported",
            "type": "list"
        },
        {
            "name": "services_performed",
            "type": "list",
            "atype": "stringlist",
            "placeholder": "Services Performed"
        },
        {
            "name": "tags",
            "type": "nested_object",
            "placeholder": "Tags"
        },
        {
            "name": "status",
            "type": "text",
            "options": [
                "pending",
                "scheduled",
                "in_progress",
                "completed",
                "cancelled"
            ],
            "indexed": true,
            "placeholder": "Status"
        }
