        "Post-Purchase Call",
        "Welcome Email / WhatsApp",
        "First-Service Reminder",
        "Accessory Suggestion",
        "Insurance / RSA Onboarding",
        "Scheduled Service Reminder",
        "Missed Service Follow-Up",
        "Seasonal Check-Up / Awareness",
        "AMC Renewal",
        "Warranty Expiry Offer",
        "Referral Program / Loyalty",
        "Birthday / Anniversary Offer",
        "Exclusive Member Event",
        "Post-Service Feedback (CSI / NPS)",
        "Customer Education / How-To",
        "Recall",
        "Recall Follow-Up Call / WhatsApp",
        "Recall Completion Confirmation"
      ],
      "option_others": true,
      "default": {
        "function": "get_from_model",
        "args": [
          "campaign_objective",
          "campaign_objective_id",
          "campaign_objective_name"
        ]
      }
    },
    {
      "name": "campaign_objective_type",
      "type": "list",
      "options": [
        "lead volume",
        "budget based",
        "roi target"
      ],
      "default": ["lead_volume"]
