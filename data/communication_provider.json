{
    "timezone": "Asia/Kolkata",
    "name": "communication_provider",
    "model_type": "default",
    "attributes": [
      {
        "name": "created",
        "type": "number",
        "auto_updater": true,
        "default": {
          "function": "now_ctime"
        }
      },
      {
        "name": "updated",
        "type": "number",
        "auto_updater": true,
        "force_update": true,
        "default": {
          "function": "now_ctime"
        }
      },
      {
        "name": "provider_name",
        "type": "text",
        "indexed": true
      },
      {
        "name": "channel",
        "type": "text",
        "options": [
          "rcs",
          "email",
          "web_chat",
          "web_chat_voice",
          "fb_chat",
          "insta_chat",
          "twitter_chat",
          "voice_phone",
          "whatsapp_chat",
          "whatsapp_voice_note",
          "whatsapp_voice_call",
          "zoom_bot",
          "ms_teams"
        ]
      },
      {
        "auto_updater": true,
        "default": {
          "args": ["provider_name","channel"],
          "function": "name_to_id",
          "kwargs": {
            "is_unique": true,
            "separator": "_",
            "skip_empty": true
          }
        },
        "name": "communication_provider_id",
        "type": "uid",
        "id": true
      }
    ]
}