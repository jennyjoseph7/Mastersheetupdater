{
    "timezone": "Asia/Kolkata",
    "name": "dealership",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "dealer_name",
            "type": "name",
            "indexed": true,
            "required": true
        },
        {
            "name": "credits_balance",
            "type": "number",
            "units": "credits",
            "default": 0 
        },
        {
            "name" : "dealership_url",
            "type" : "text",
            "constraint": {
                "function": "url_validator"
            },
                "converter": {
                "function": "url_converter"
            }
        },
        {
            "name" : "pan_card",
            "type" : "file"
            
        },
        {
            "name" : "pan_card_link",
            "type" : "text",
            "constraint": {
                "function": "url_validator"
            },
                "converter": {
                "function": "url_converter"
            },
            "ui_element" : "file"

        },
        {
            "name" : "gstin",
            "type" : "text"
        },
        {
            "name" : "gst_certificate",
            "type" : "file"

        },
        {
            "name" : "dealership_legal_name",
            "type" : "text",
            "default": {
                "function": "copy_attribute",
                "args": [
                    "dealer_name"
                ]
            }
        },
        {
            "name" : "certificate_of_incorporation",
            "type" : "text",
            "ui_element": "file",
            "constraint": {
                "function": "url_validator"
            },
            "converter": {
                "function": "url_converter"
            }
        },
        {
            "name": "aliases",
            "type":"string_list",
            "converter" : {
                "function" : "ensure_in_list",
                "args" : ["dealership_legal_name","dealer_name"]
            }
        },
        {
            "name": "dealer_group_id",
            "refers": "parents.dealer_group.dealer_group_id",
            "required": false
        },
        {
            "name": "dealer_group_name",
            "refers": "parents.dealer_group.dealer_group_name"
        },
        {
            "name": "dealer_group_guidelines",
            "refers": "parents.dealer_group.dealer_group_guidelines"
        },
        {
            "name": "dealer_group_description",
            "refers": "parents.dealer_group.dealer_group_description"
        },
        {
            "default": "Single Brand",
            "name": "dealership_type",
            "type": "text",
            "options": [
                "Single Brand",
                "Multi Brand"
            ]
        },
        {
            "name": "supported_brands",
            "type": "list",
            "ui_element": "multiselect",
            "options": "/options/brand/brand_name",
            "required": false
        },
        {
            "name": "suppored_brand_names",
            "type": "list",
            "default": {
                "function": "get_from_model_map",
                "args": [
                    "brand",
                    "brand_id",
                    "brand_name"
                ]
            }
        },
        {
            "name": "supported_brands_guidelines",
            "type": "object_list",
            "dict_keys": [
                "brand_name",
                "brand_level_guidelines",
                "brand_level_guardrails"
            ],
            "default": {
                "function": "get_from_model_map",
                "args": [
                    "brand",
                    "brand_id"
                ],
                "kwargs": {
                    "_attributes": [
                        "brand_name",
                        "brand_level_guidelines",
                        "brand_level_guardrails"
                    ]
                }
            }
        },
        {
            "name": "channels",
            "type": "list",
            "options": [
                "rcs",
                "email",
                "web_chat",
                "web_chat_voice",
                "fb_chat",
                "insta_chat",
                "twitter_chat",
                "voice_phone",
                "whatsapp_chat",
                "whatsapp_voice_note",
                "whatsapp_voice_call",
                "zoom_bot",
                "ms_teams"
            ],
            "ui_element": "multiselect"
        },
        {
            "name": "region_id",
            "refers": "parents.region.region_id",
            "required": true
        },
        {
            "name": "region_name",
            "refers": "parents.region.region_name"
        },
        {
            "name": "region_level_guidelines",
            "refers": "parents.region.region_level_guidelines"
        },
        {
            "name": "region_level_guardrails",
            "refers": "parents.region.region_level_guardrails"
        },
        {
            "name": "showroom_center_count",
            "type": "number"
        },
        {
            "name": "workshop_center_count",
            "type": "number"
        },
        {
            "name": "buyback_center_count",
            "type": "number"
        },
        {
            "name": "website",
            "type": "text",
            "converter": {
                "function": "url_converter"
            },
            "constraint": {
                "function": "url_validator"
            },
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealer_group",
                    "dealer_group_id",
                    "website"
                ]
            }
        },
        {
            "name": "linkedin_url",
            "type": "text",
            "converter": {
                "function": "url_converter"
            },
            "constraint": {
                "function": "url_validator"
            },
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealer_group",
                    "dealer_group_id",
                    "linkedin_url"
                ]
            }
        },
        {
            "name": "year_established",
            "type": "number",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealer_group",
                    "dealer_group_id",
                    "year_established"
                ]
            }
        },
        {
            "name": "billing_address",
            "type": "text"
        },
        {
            "name": "billing_contact_name",
            "type": "text"
        },
        {
            "name": "billing_contact_email",
            "type": "text",
            "constraint": {
                "function": "email_validator"
            }
        },
        {
            "name": "billing_contact_phone",
            "type": "text",
            "constraint": {
                "function": "phone_validator"
            }
        },
        {
            "name": "primary_contact_name",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealer_group",
                    "dealer_group_id",
                    "primary_contact_name"
                ]
            }
        },
        {
            "name": "primary_contact_role",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealer_group",
                    "dealer_group_id",
                    "primary_contact_role"
                ]
            }
        },
        {
            "name": "primary_contact_email",
            "type": "text",
            "constraint": {
                "function": "email_validator"
            },
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealer_group",
                    "dealer_group_id",
                    "primary_contact_email"
                ]
            }
        },
        {
            "name": "primary_contact_phone",
            "type": "text",
            "constraint": {
                "function": "phone_validator"
            },
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealer_group",
                    "dealer_group_id",
                    "primary_contact_phone"
                ]
            }
        },
        {
            "name": "secondary_contact_name",
            "type": "text"
        },
        {
            "name": "secondary_contact_role",
            "type": "text"
        },
        {
            "name": "secondary_contact_email",
            "type": "text",
            "constraint": {
                "function": "email_validator"
            }
        },
        {
            "name": "secondary_contact_phone",
            "type": "text",
            "constraint": {
                "function": "phone_validator"
            }
        },
        {
            "name": "dealership_guidelines",
            "type": "text"
        },
        {
            "name": "dealership_guardrails",
            "type": "text"
        },
        {
            "name": "dealership_description",
            "type": "text"
        },
        {
            "name": "dealer_status",
            "type": "text",
            "options": [
                "active",
                "inactive",
                "suspended"
            ],
            "indexed": true
        },
        {
            "name": "dealership_id",
            "type": "uid",
            "indexed": true,
            "id": true,
            "default": {
                "function": "name_to_id",
                "args": [
                    "dealer_name",
                    "dealer_group_name",
                    "region_name"
                ],
                "kwargs": {
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-",
                    "skip_empty": true
                }
            },
            "auto_updater": true
        }
    ],
    "parents": [
        "dealer_group",
        "region"
    ]
}
