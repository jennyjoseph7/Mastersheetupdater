                    "dealership",
                    "dealership_id",
                    "dealer_name"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "dealer_location",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_location"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "dealer_address",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_address"
                ]
            },
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "campaign_id",
            "type": "uid",
