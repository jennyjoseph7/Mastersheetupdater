{
    "attributes": [
        {
            "name": "template_name",
            "type": "text",
            "indexed": true,
            "required": true
        },
        {
            "required": true,
            "name": "title",
            "type": "text",
            "indexed": true
        },
        {
            "name": "region_id",
            "refers": "parents.region.region_id",
            "required": true
        },
        {
            "name": "region_name",
            "refers": "parents.region.region_name",
            "required": true
        },
        {
            "name": "brand_id",
            "refers": "parents.brand.brand_id",
            "required": true,
            "options": "/options/brand/brand_name?region_id={region_id}"
        },
        {
            "name": "brand_name",
            "refers": "parents.brand.brand_name"
        },
        {
            "name": "vehicle_model_id",
            "type": "text",
            "options": "/options/vehicle_model/vehicle_model_name?brand_id={brand_id}"
        },
        {
            "name": "vehicle_model_name",
            "type": "text",
            "force_update": ["brand_id", "region_id", "vehicle_model_id"],
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle_model",
                    "vehicle_model_id",
                    "vehicle_model_name"
                ]
            }
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "region_name",
                    "title",
                    "brand_name",
                    "vehicle_model_name",
                    "template_name"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "is_unique": true,
                    "separator": "-",
                    "case": "lower",
                    "skip_empty": true,
                    "attribute_join": "-"
                }
            },
            "id": true,
            "name": "template_id",
            "type": "uid"
        },
        {
            "name": "description",
            "type": "text"
        },
        {
            "name": "hashtags",
            "type": "string_list",
            "list_type": "text",
            "indexed": true
        },
        {
            "name": "image_url",
            "type": "text",
            "constraint": {
                "function": "url_validator"
            },
            "converter": {
                "function": "url_converter"
            },
            "ui_element": "image"
        },
        {
            "name": "thumbnail_url",
            "type": "text",
            "constraint": {
