{
    "timezone": "Asia/Kolkata",
    "name": "review",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "showroom_name",
            "refers": "parents.showroom.showroom_name"
        },
        {
            "name": "dealership_id",
            "refers": "parents.dealership.dealership_id"
        },
        {
            "name": "dealership_name",
            "refers": "parents.dealership.dealership_name"
        },
        {
            "name": "person_id",
            "refers": "parents.person.user_id"
        },
        {
            "name": "person_name",
            "refers": "parents.person.name"
        },
        {
            "name": "visit_date",
            "refers": "parents.showroom_visit.visit_date"
        },
        {
            "name": "purpose_of_visit",
            "refers": "parents.showroom_visit.purpose_of_visit"
        },
        {
            "name": "models_interested_in",
            "refers": "parents.showroom_visit.models_interested_in"
        },
        {
            "name": "variants_interested_in",
            "refers": "parents.showroom_visit.variants_interested_in"
        },
        {
            "name": "test_drive_offered",
            "type": "boolean",
            "default": false
        },
        {
            "name": "test_drive_done",
            "type": "boolean",
            "default": false
        },
        {
            "name": "visit_helped_in_decision",
            "type": "boolean",
            "default": false
        },
        {
            "name": "able_to_make_a_decision",
            "type": "boolean",
            "default": false
        },
        {
            "name": "competitor_brands_considered",
            "type": "list",
            "list_type": "text"
        },
        {
            "name": "likely_to_purchase_models",
            "type": "list",
            "list_type": "text"
        },
        {
            "name": "source_type",
            "type": "text",
            "options": [
                "Google",
                "Facebook",
                "Instagram",
                "WhatsApp",
                "SMS",
                "In-person",
                "Phone Call",
                "Email",
                "Other"
            ],
            "ui_element": "select"
        },
        {
            "name": "review_type",
            "type": "text",
            "options": [
                "Showroom Experience",
                "Service Experience",
                "Sales Experience",
                "Product Feedback",
                "Website/App Experience",
                "Delivery Experience",
                "Support/Communication"
            ],
            "ui_element": "select"
        },
        {
            "name": "rating_overall",
            "type": "number",
            "title": "Overall Rating (1-5)",
            "constraint": {
                "min": 1,
                "max": 5
            },
            "ui_element": "rating"
        },
        {
            "name": "rating_staff_behavior",
            "type": "number",
            "title": "Staff Behavior Rating (1-5)",
            "constraint": {
                "min": 1,
                "max": 5
            },
            "ui_element": "rating"
        },
        {
            "name": "rating_service_quality",
            "type": "number",
            "title": "Service Quality Rating (1-5)",
            "constraint": {
                "min": 1,
                "max": 5
            },
            "ui_element": "rating"
        },
        {
            "name": "review_text",
            "type": "text",
            "title": "Review Comments",
            "ui_element": "textarea"
        },
        {
            "name": "media_attachments",
            "type": "list",
            "title": "Photos / Videos Attached (URLs)"
        },
        {
            "name": "sentiment",
            "type": "list",
            "list_type": "text",
            "ui_element": "tags",
            "option_others": true,
            "options": [
                "Positive",
                "Neutral",
                "Negative",
                "Curious",
                "Angry",
                "Impressed",
                "Disinterested",
                "Disappointed",
                "Happy",
                "Surprised",
                "Excited",
                "Frustrated",
                "Satisfied",
                "Interested",
                "Confused",
                "Bored",
                "Sleepy",
                "Stressed",
                "Anxious"
            ],
            "converter": {
                "function": "make_title"
            }
        },
        {
            "name": "sentiment_score",
            "type": "number"
        },
        {
            "name": "feedback_category",
            "type": "text",
            "options": [
                "Suggestion",
                "Complaint"
            ],
            "ui_element": "select"
        },
        {
            "name": "response_status",
            "type": "text",
            "options": [
                "Pending",
                "Acknowledged",
                "Resolved",
                "Escalated",
                "Closed"
            ],
            "ui_element": "select"
        },
        {
            "name": "review_date",
            "type": "datetime"
        },
        {
            "name": "resolved_date",
            "type": "datetime"
        },
        {
            "name": "review_status",
            "type": "text",
            "options": [
                "Active",
                "Flagged",
                "Hidden",
                "Archived"
            ],
            "ui_element": "select"
        },
        {
            "name": "review_tags",
            "type": "list",
            "title": "Tags / Keywords"
        },
        {
            "name": "remarks",
            "type": "text"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "showroom_name",
                    "phone_number",
                    "email",
                    "person_name",
                    "visit_date"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-",
                    "skip_empty": true
                }
            },
            "name": "review_id",
            "type": "uid",
            "id": true
        }
    ],
    "parents": [
        "dealership",
        "person",
        "showroom_visit"
    ]
}