{
    "timezone": "Asia/Kolkata",
    "name": "buyback_center",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "dealership_id",
            "refers": "parents.dealership.dealership_id",
            "indexed": true
        },
        {
            "name": "dealer_name",
            "refers": "parents.dealership.dealer_name"
        },
        {
            "name": "supported_buyback_brands",
            "type": "list"
        },
        {
            "name": "region_id",
            "refers": "parents.dealership.region_id"
        },
        {
            "name": "region_name",
            "refers": "parents.dealership.region_name"
        },
        {
            "name": "buyback_center_name",
            "type": "text",
            "indexed": true
        },
        {
            "name": "buyback_center_code",
            "type": "text",
            "indexed": true
        },
        {
            "name": "buyback_center_type",
            "type": "text",
            "options": [
                "All Categories",
                "Used Cars"
            ]
        },
        {
            "name": "contact_number",
            "type": "text"
        },
        {
            "name": "email",
            "type": "text"
        },
        {
            "name": "address",
            "type": "text"
        },
        {
            "name": "city",
            "type": "text"
        },
        {
            "name": "state",
            "type": "text"
        },
        {
            "name": "pincode",
            "type": "text"
        },
        {
            "name": "geolocation",
            "type": "geolocation"
        },
        {
            "name": "operating_hours",
            "type": "nested_object",
            "dict_keys": [
                "opening_time",
                "closing_time"
            ]
        },
        {
            "name": "days_open",
            "type": "string_list",
            "ui_element": "multiselect",
            "option_others": true,
            "options": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Sunday"
            ]
        },
        {
            "name": "total_appraisers",
            "type": "number"
        },
        {
            "name": "services_offered",
            "type": "string_list",
            "ui_element": "multiselect",
            "option_others": true,
            "options": [
                "Appraisal",
                "Inspection",
                "Ownership Transfer",
                "Documentation",
                "Payment",
                "Registration Number Transfer",
                "Hypothecation Release",
                "Vehicle Storage",
                "Vehicle Pickup",
                "Vehicle Disposal",
                "Vehicle Delivery",
                "Insurance",
                "Finance",
                "Legal",
                "Other"
            ]
        },
        {
            "name": "facilities_available",
            "type": "string_list",
            "ui_element": "multiselect",
            "option_others": true,
            "options": [
                "Customer Lounge",
                "Wi-Fi",
                "Cafe / Refreshments",
                "Insurance Desk",
                "Accessories Section",
                "EV Charging Point",
                "Children Play Area",
                "Parking Facility",
                "Virtual Reality Experience",
                "Online Booking Portal",
                "Extended Working Hours",
                "Personal Appraiser Executive",
                "Weekend Availability",
                "Festive Offers",
                "Loyalty Programs",
                "CCTV Waiting Area",
                "Associated Showroom",
                "Associated Workshop",
                "Credit Card Payment Facility",
                "Debit Card Payment Facility",
                "UPI Payment Facility",
                "Cash Payment Facility",
                "Cheque Payment Facility"
            ]
        },
        {
            "name": "manager_name",
            "type": "text"
        },
        {
            "name": "manager_contact",
            "type": "text"
        },
        {
            "name": "workshop_status",
            "type": "text",
            "options": [
                "Active",
                "Inactive",
                "Under Renovation"
            ],
            "indexed": true
        },
        {
            "name": "display_vehicle_count",
            "type": "number"
        },
        {
            "name": "google_reviews_rating",
            "type": "text"
        },
        {
            "name": "google_reviews",
            "type": "text"
        },
        {
            "name": "google_my_business_listing",
            "type": "text"
        },
        {
            "name": "buyback_center_reviews",
            "type": "text"
        },
        {
            "name": "buyback_center_photos",
            "type": "text"
        },
        {
            "name": "buyback_center_rating",
            "type": "text"
        },
        {
            "name": "region_level_guidelines",
            "refers": "parents.dealership.region_level_guidelines"
        },
        {
            "name": "region_level_guardrails",
            "refers": "parents.dealership.region_level_guardrails"
        },
        {
            "name": "supported_brands_guidelines",
            "refers": "parents.dealership.supported_brands_guidelines"
        },
        {
            "name": "buyback_center_level_guidelines",
            "type": "text"
        },
        {
            "name": "buyback_center_level_guardrails",
            "type": "text"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "dealer_name",
                    "workshop_name",
                    "city"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-",
                    "skip_empty": true,
                    "case": "lower"
                }
            },
            "name": "buyback_center_id",
            "type": "uid",
            "id": true
        }
    ],
    "parents": [
        "dealership"
    ]
}