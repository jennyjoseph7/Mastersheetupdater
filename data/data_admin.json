{
    "name": "data_admin",
    "timezone": "Asia/Kolkata",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "admin_name",
            "type": "text",
            "required": true,
            "indexed": true
        },
        {
            "name": "phone_number",
            "type": "text",
            "constraint": {
                "function": "phone_validator"
            },
            "indexed": true
        },
        {
            "name": "email",
            "type": "text",
            "required": true,
            "default": "noreply@setemailofuser.com",
            "constraint": {
                "function": "email_validator"
            },
            "indexed": true
        },
        {
            "name": "password",
            "type": "password",
            "required": true,
            "default": {
                "function": "make_view_id",
                "args": [
                    8
                ],
                "kwargs": {
                    "make_unique": false
                }
            },
            "constraint": {
                "function": "password_validator",
                "args": [
                    8
                ],
                "kwargs": {
                    "check_digit": true,
                    "check_case": true
                }
            }
        },
        {
            "name": "password_expiry",
            "type": "number",
            "auto_updater": true,
            "force_update": "password",
            "required": true,
            "default": {
                "function": "sum_attributes",
                "args": [
                    "updated",
                    2592000
                ]
            }
        },
        {
            "name": "role",
            "type": "text",
            "options": [
                "Spark Admin",
                "Brochure Admin"
            ],
            "option_others": true
        },
        {
            "name": "data_admin_id",
            "type": "uid",
            "id": true,
            "auto_updater": true,
            "default": {
                "function": "make_uuid3",
                "args": [
                    "admin_name",
                    "phone_number",
                    "email"
                ]
            }
        }
    ],
    "has_login": true
}
