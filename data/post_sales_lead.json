            "type": "list"
        },
        {
            "auto_updater": true,
            "default": {
                "args": ["vehicle_id", "dealership_id", "campaign_id"],
                "function": "name_to_id",
                "kwargs": {
                "attribute_join": " ",
                "is_unique": true,
                "separator": " - ",
                "skip_empty": true
                }
            },
            "name": "post_sales_lead_id",
            "type": "uid",
            "id": true
        }
