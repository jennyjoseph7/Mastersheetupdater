{
  "timezone": "Asia/Kolkata",
  "name": "template",
  "model_type": "default",
  "parents": [
    "communication_credential"
  ],
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "template_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "communication_credential_id",
      "refers": "parents.communication_credential.communication_credentials_id",
      "required": true
    },
    {
      "name": "provider_name",
      "refers": "parents.communication_credential.provider_name",
      "indexed": true
    },
    {
      "name": "channel",
      "refers": "parents.communication_credential.channel"
    },
    {
      "name": "sender",
      "refers": "parents.communication_credential.sender"
    },
    {
      "name": "region_name",
      "refers": "parents.communication_credential.region_name"
    },
    {
      "name": "dealer_name",
      "refers": "parents.communication_credential.dealer_name"
    },
    {
      "name": "template_type",
      "type": "text",
      "required": true
    },
    {
      "name": "template_message",
      "type": "text"
    },
    {
      "name": "template_variables",
      "type": "list"
    },
    {
      "name": "template_buttons_payload",
      "type": "list"
    },
    {
      "name": "template_media_id",
      "type": "text"
    },
    {
      "name": "media_file_name",
      "type": "text"
    },
    {
      "name": "template_media_type",
      "type": "text"
    },
    {
      "name": "template_media_url",
      "type": "text"
    },
    {
      "name": "template_payload",
      "type": "nested_object"
    },
    {
      "name": "language",
      "type": "text",
      "default": "english",
      "option_other": true,
      "options": [
        "english",
        "hindi",
        "kannada",
        "telugu",
        "tamil",
        "malayalam",
        "odia",
        "bengali",
        "marathi",
        "gujarati",
        "bengali",
        "assamese",
        "punjabi",
        "spanish",
        "arabic"
      ],
      "ui_element": "select"
    },
    {
      "name": "status",
      "type": "list",
      "options": ["pending", "approved", "rejected"]
    },
    {
      "name": "template_id",
      "type": "uid",
      "indexed": true,
      "id": true,
      "default": {
        "function": "make_uuid_timestamp"
      }
    }
  ]
}
