{
    "timezone": "Asia/Kolkata",
    "name": "vehicle",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "variant_id",
            "refers": "parents.variant.variant_id"
        },
        {
            "name": "variant_name",
            "refers": "parents.variant.variant_name"
        },
        {
            "name": "oem_id",
            "refers": "parents.variant.oem_id"
        },
        {
            "name": "brand_id",
            "refers": "parents.variant.brand_id"
        },
        {
            "name": "brand_name",
            "refers": "parents.variant.brand_name"
        },
        {
            "name": "model_id",
            "refers": "parents.variant.model_id"
        },
        {
            "name": "model_name",
            "refers": "parents.variant.model_name"
        },
        {
            "name": "variant_color_id",
            "refers": "parents.variant_color.variant_color_id"
        },
        {
            "name": "variant_color_name",
            "refers": "parents.variant_color.variant_color_name"
        },
        {
            "name": "model_year_id",
            "refers": "parents.variant.model_year_id"
        },
        {
            "name": "model_launch_year",
            "refers": "parents.variant.model_year"
        },
        {
            "name": "reg_number",
            "type": "text",
            "indexed": true
        },
        {
            "name": "vin_number",
            "type": "text",
            "indexed": true
        },
        {
            "name": "vehicle_type",
            "type": "text",
            "options": [
                "Hatchback",
                "Sedan",
                "SUV",
                "MUV",
                "Coupe",
                "Convertible",
                "Station Wagon",
                "Pickup Truck",
                "Sports Car",
                "Luxury Car",
                "EV",
                "Hybrid",
                "Commercial Vehicle",
                "Two-Wheeler",
                "Three-Wheeler",
                "Other"
            ],
            "ui_element": "select"
        },
        {
            "name": "transmission",
            "type": "text",
            "options": [
                "Manual",
                "Automatic",
                "AMT",
                "CVT",
                "DCT",
                "Other"
            ],
            "ui_element": "select"
        },
        {
            "name": "fuel_type",
            "type": "text",
            "options": [
                "Petrol",
                "Diesel",
                "Electric",
                "CNG",
                "Hybrid",
                "LPG",
                "Other"
            ],
            "ui_element": "select"
        },
        {
            "name": "engine_capacity",
            "type": "number",
            "units": "cc"
        },
        {
            "name": "drivetrain",
            "type": "text",
            "options": [
                "FWD",
                "RWD",
                "AWD",
                "4WD"
            ],
            "ui_element": "select"
        },
        {
            "name": "engine_number",
            "type": "text"
        },
        {
            "name": "chassis_number",
            "type": "text"
        },
        {
            "name": "purchase_date",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "registration_date",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "delivery_date",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "last_service_date",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "next_service_due",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "warranty_expiry_date",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "insurance_expiry_date",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "loan_end_date",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "odometer_reading",
            "type": "number",
            "units": "km"
        },
        {
            "name": "odometer_reading_date",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "avg_monthly_mileage",
            "type": "number",
            "units": "km"
        },
        {
            "name": "vehicle_usage_category",
            "type": "text",
            "options": [
                "Personal",
                "Fleet",
                "Commercial",
                "Rental",
                "Demo"
            ],
            "ui_element": "select"
        },
        {
            "name": "battery_health",
            "type": "text",
            "options": [
                "Good",
                "Average",
                "Weak",
                "Needs Replacement"
            ]
        },
        {
            "name": "battery_warranty",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "oil_change",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "brake_pad_change",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "tyre_change",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "wheel_alignment",
            "type": "text",
            "options": [
                "Front-end",
                "Thrust",
                "Four-wheel"
            ]
        },
        {
            "name": "suspension_check",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "coolant_radiator_service",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "ac_vent_cleaning",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "underbody_coating",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "car_wash",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "repair_notes",
            "type": "text"
        },
        {
            "name": "first_owner_name",
            "type": "text"
        },
        {
            "name": "ownership_status",
            "type": "text",
            "options": [
                "Owned",
                "Leased",
                "Financed",
                "Fleet"
            ]
        },
        {
            "name": "loan_provider",
            "type": "text"
        },
        {
            "name": "loan_account_number",
            "type": "text"
        },
        {
            "name": "loan_amount",
            "type": "number",
            "units": "INR"
        },
        {
            "name": "emi_amount",
            "type": "number",
            "units": "INR"
        },
        {
            "name": "emi_due_date",
            "type": "number",
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "insurance",
            "type": "nested_object",
            "dict_keys": [
                "policy_number",
                "provider",
                "expiry_date",
                "insured_value"
            ]
        },
        {
            "name": "puc",
            "type": "nested_object",
            "dict_keys": [
                "certificate_number",
                "expiry_date"
            ]
        },
        {
            "name": "gps_tracker",
            "type": "nested_object",
            "dict_keys": [
                "device_id",
                "installed_date",
                "last_location",
                "last_online"
            ]
        },
        {
            "name": "current_location",
            "type": "geolocation",
            "title": "Current GPS Location"
        },
        {
            "name": "last_trip_summary",
            "type": "nested_object",
            "dict_keys": [
                "trip_distance_km",
                "avg_speed_kmph",
                "fuel_used_ltr",
                "duration_min"
            ]
        },
        {
            "name": "documents",
            "type": "object_list",
            "list_type": "nested_object",
            "dict_keys": [
                "doc_type",
                "doc_number",
                "expiry_date",
                "file_url"
            ]
        },
        {
            "name": "fastag_id",
            "type": "text"
        },
        {
            "name": "rc_book_number",
            "type": "text"
        },
        {
            "name": "rc_scanned_copy",
            "type": "text",
            "ui_element": "file"
        },
        {
            "name": "vehicle_persona_summary",
            "type": "text"
        },
        {
            "name": "customer_score",
            "type": "number"
        },
        {
            "name": "status",
            "type": "text",
            "options": [
                "Active",
                "In Service",
                "Sold",
                "Scrapped",
                "Pending Transfer",
                "Inactive"
            ],
            "ui_element": "select"
        },
        {
            "name": "description",
            "type": "text"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "variant_name",
                    "variant_color_name",
                    "vin_number"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " - "
                }
            },
            "name": "vehicle_id",
            "type": "uid",
            "id": true
        }
    ],
    "parents": [
        "variant",
        "variant_color"
    ]
}