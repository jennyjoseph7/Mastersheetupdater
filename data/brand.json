{
  "timezone": "Asia/Kolkata",
  "name": "brand",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "oem_id",
      "refers": "parents.oem.oem_id",
      "required": false
    },
    {
      "name": "oem_name",
      "refers": "parents.oem.oem_name"
    },
    {
      "name": "oem_brand_awareness",
      "refers": "parents.oem.oem_brand_awareness"
    },
    {
      "name": "oem_wiki_description",
      "refers": "parents.oem.oem_wiki_description"
    },
    {
      "name": "oem_vehicle_categories",
      "refers": "parents.oem.oem_vehicle_categories"
    },
    {
      "name": "oem_country_of_origin",
      "refers": "parents.oem.oem_country_of_origin"
    },
    {
      "name": "region_id",
      "refers": "parents.region.region_id",
      "required": true
    },
    {
      "name": "region_name",
      "refers": "parents.region.region_name"
    },
    {
      "name": "country_name",
      "refers": "parents.region.country_name"
    },
    {
      "name": "region_level_guidelines",
      "refers": "parents.region.region_level_guidelines"
    },
    {
      "name": "region_level_guardrails",
      "refers": "parents.region.region_level_guardrails"
    },
    {
      "name": "parent_company",
      "refers": "parents.oem.parent_company"
    },
    {
      "name": "brand_level_guidelines",
      "type": "text",
      "ui_element": "textarea"
    },
    {
      "name": "brand_level_guardrails",
      "type": "text",
      "ui_element": "textarea"
    },
    {
      "name": "brand_name",
      "type": "text",
      "indexed": true,
      "required": true
    },
    {
      "name": "logo_url",
      "type": "text",
      "constraint": {
        "function": "url_validator"
      },
      "converter": {
        "function": "url_converter"
      },
      "ui_element": "image"
    },
    {
      "name": "website",
      "type": "text",
      "constraint": {
        "function": "url_validator"
      },
      "converter": {
        "function": "url_converter"
      },
      "ui_element": "url"
    },
    {
      "auto_updater": true,
      "default": {
        "args": [
          "brand_name",
          "oem_id",
          "region_id"
        ],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": "-",
          "is_unique": true,
          "separator": "-",
          "skip_empty": true,
          "case": "lower"
        }
      },
      "name": "brand_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "oem",
    "region"
  ]
}