{
    "name": "model_year_image",
    "model_type": "default",
    "parents": [
        "model_year"
    ],
    "attributes": [
        {
            "name": "model_year_id",
            "refers": "parents.model_year.model_year_id",
            "indexed": true,
            "required": true
        },
        {
            "name": "image_url",
            "type": "text",
            "required": true
        },
        {
            "name": "model_year_image_id",
            "type": "uid",
            "id": true,
            "default": {
                "function": "make_uuid3",
                "args": ["model_year_id", "image_url"]
            }
        },
        {
            "name": "vehicle_model_name",
            "refers": "parents.model_year.vehicle_model_name",
            "indexed": true
        },
        {
            "name": "oem_name",
            "refers": "parents.model_year.oem_name",
            "indexed": true
        },
        {
            "name": "brand_name",
            "refers": "parents.model_year.brand_name",
            "indexed": true
        },
        {
            "name": "year",
            "refers": "parents.model_year.year",
            "indexed": true
        },
        {
            "name": "year_label",
            "refers": "parents.model_year.year_label"
        },
        {
            "name": "vehicle_model_id",
            "refers": "parents.model_year.vehicle_model_id"
        },
        {
            "name": "brand_id",
            "refers": "parents.model_year.brand_id"
        },
        {
            "name": "region_id",
            "refers": "parents.model_year.region_id"
        },
        {
            "name": "region_name",
            "refers": "parents.model_year.region_name"
        },
        {
            "name": "search_terms",
            "type": "text",
            "default": {
                "function": "name_to_id",
                "args": [
                    "oem_name",
                    "vehicle_category",
                    "vehicle_type",
                    "region_name",
                    "vehicle_model_name",
                    "brand_name",
                    "year_label"
                ],
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " ",
                    "case": "lower",
                    "skip_empty": true
                }
            },
            "indexed": true
        }
    ]
}