{
    "timezone": "Asia/Kolkata",
    "name": "feedback",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "service_visit_id",
            "refers": "parents.service_visit.service_visit_id"
        },
        {
            "name": "user_id",
            "refers": "parents.service_visit.user_id"
        },
        {
            "name": "person_name",
            "refers": "parents.service_visit.person_name"
        },
        {
            "name": "person_name",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "person_name"
                ]
            }
        },
        {
            "name": "phone_number",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "last_contacted_phone_number"
                ]
            },
            "indexed": true
        },
        {
            "name": "email",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "last_contacted_email"
                ]
            },
            "indexed": true
        },
        {
            "name": "whatsapp_number",
            "default": {
                "function": "get_from_model",
                "args": [
                    "person",
                    "user_id",
                    "last_contacted_whatsapp_number"
                ]
            },
            "indexed": true
        },
        {
            "name": "dealership_id",
            "refers": "parents.service_visit.dealership_id"
        },
        {
            "name": "dealership_name",
            "refers": "parents.service_visit.dealer_name",
            "indexed": true
        },
        {
            "name": "visit_date",
            "refers": "parents.service_visit.visit_date"
        },
        {
            "name": "vehicle_model_id",
            "refers": "parents.service_visit.vehicle_model_id"
        },
        {
            "name": "vehicle_model_name",
            "refers": "parents.service_visit.vehicle_model_name"
        },
        {
            "name": "vehicle_brand_id",
            "refers": "parents.service_visit.vehicle_brand_id"
        },
        {
            "name": "vehicle_brand_name",
            "refers": "parents.service_visit.vehicle_brand_name"
        },
        {
            "name": "overall_rating",
            "type": "number"
        },
        {
            "name": "description_of_services",
            "type": "text"
        },
        {
            "name": "purpose_of_visit",
            "refers": "parents.service_visit.purpose_of_visit"
        },
        {
            "name": "services_performed",
            "type": "string_list",
            "list_type": "text",
            "ui_element": "multiselect",
            "option_others": true,
            "options": [
                "Free Service",
                "Paid Service",
                "General Service",
                "Inspection",
                "Repair",
                "Body Shop",
                "Body Work / Denting",
                "Paint Work",
                "Paint Protection",
                "Engine Service",
                "Brakes Service",
                "Transmission / Gearbox Service",
                "AC / HVAC Service",
                "Electrical Work / Components Service",
                "Battery Service",
                "Battery Replacement",
                "Tyre Work",
                "Tyre Replacement",
                "Wheel Alignment / Balancing",
                "Suspension / Shock Absorber Service",
                "Steering System Service",
                "Exhaust / Emission System Service",
                "Fuel System Service",
                "Cooling / Radiator System Service",
                "Interior Cleaning / Detailing",
                "Exterior Polishing / Paint Protection",
                "Lighting / Headlamp Service",
                "Wiper / Washer System Service",
                "Sensor / Electronics Calibration",
                "Software / ECU Update",
                "Navigation / Infotainment Update",
                "Recall Action",
                "Accessories Installation / Replacement",
                "General Health Check-up",
                "Preventive Maintenance",
                "Emission / Pollution Test",
                "Oil Change",
                "Oil Filter Change",
                "Insurance Claim",
                "Warranty Claim",
                "Pickup",
                "Drop",
                "Roadside Assistance",
                "Spare Parts",
                "Charging",
                "Other"
            ]
        },
        {
            "name": "document",
            "type": "list",
            "title": "Upload Document"
        },
        {
            "name": "rating_service_quality",
            "type": "number"
        },
        {
            "name": "rating_vehicle_performance",
            "type": "number"
        },
        {
            "name": "rating_staff_behaviour",
            "type": "number"
        },
        {
            "name": "did_they_overcharge",
            "type": "bool"
        },
        {
            "name": "follow_up_by",
            "type": "text"
        },
        {
            "name": "follow_up_date",
            "type": "number"
        },
        {
            "name": "emotions",
            "type": "text",
            "option_others": true,
            "options": [
                "Positive",
                "Neutral",
                "Negative"
            ]
        },
        {
            "name": "sentiment_score",
            "type": "number"
        },
        {
            "name": "response_status",
            "type": "text",
            "options": [
                "New",
                "Acknowledged",
                "Reviewed",
                "Action Taken",
                "Escalated",
                "Closed",
                "Rejected"
            ]
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "brand_name",
                    "model_name",
                    "variant_name",
                    "person_name",
                    "feedback_category",
                    "service_date"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " - "
                }
            },
            "name": "feedback_id",
            "type": "uid",
            "id": true
        }
    ],
    "parents": [
        "service_visit"
    ]
}