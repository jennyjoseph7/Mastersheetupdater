                "function": "get_from_model",
                "args": [
                    "variant",
                    "variant_id",
                    "brand_name"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "variant_id"
        },
        {
            "name": "vehicle_model_year",
            "type": "number",
            "default": {
                "function": "get_from_model",
                "args": [
                    "variant",
                    "variant_id",
                    "vehicle_model_year"
                ]
            },
            "auto_updater": true,
            "force_update": "variant_id"
        },
        {
            "name": "vehicle_color_id",
            "type": "uid"
        },
        {
            "name": "vehicle_color_name",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "variant_color",
                    "variant_color_id",
                    "color_name"
                ]
            },
            "auto_updater": true,
            "force_update": "variant_color_id"
        },
        {
            "name": "reg_number",
            "type": "text",
            "required": true,
            "indexed": true
        },
        {
            "name": "vin_number",
            "type": "text",
            "indexed": true
        },
        {
            "name": "vehicle_category",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "variant",
                    "variant_id",
                    "vehicle_category"
                ]
            }
        },
        {
            "name": "vehicle_type",
            "type": "text",
