{
    "timezone": "Asia/Kolkata",
    "name": "vehicle_model",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "brand_id",
            "refers": "parents.brand.brand_id",
            "default": {
                "function": "search_in_model",
                "args": [
                    "brand",
                    "brand_name"
                ],
                "kwargs": {
                    "brand_name": "{brand_name}"
                }
            }
        },
        {
            "name": "brand_name",
            "refers": "parents.brand.brand_name"
        },
        {
            "name": "region_id",
            "refers": "parents.brand.region_id"
        },
        {
            "name": "region_name",
            "refers": "parents.brand.region_name"
        },
        {
            "name": "country_name",
            "refers": "parents.brand.country_name"
        },
        {
            "name": "region_level_guidelines",
            "refers": "parents.brand.region_level_guidelines"
        },
        {
            "name": "region_level_guardrails",
            "refers": "parents.brand.region_level_guardrails"
        },
        {
            "name": "brand_logo_url",
            "refers": "parents.brand.logo_url"
        },
        {
            "name": "brand_website",
            "refers": "parents.brand.website"
        },
        {
            "name": "parent_company",
            "refers": "parents.brand.parent_company"
        },
        {
            "name": "brand_level_guidelines",
            "refers": "parents.brand.brand_level_guidelines"
        },
        {
            "name": "brand_level_guardrails",
            "refers": "parents.brand.brand_level_guardrails"
        },
        {
            "name": "oem_id",
            "refers": "parents.brand.oem_id",
            "default": {
                "function": "search_in_model",
                "args": [
                    "oem",
                    "oem_id"
                ],
                "kwargs": {
                    "oem_name": "{oem_name}"
                }
            }
        },
        {
            "name": "oem_name",
            "refers": "parents.brand.oem_name"
        },
        {
            "name": "oem_brand_awareness",
            "refers": "parents.brand.oem_brand_awareness"
        },
        {
            "name": "oem_country_of_origin",
            "refers": "parents.brand.oem_country_of_origin"
        },
        {
            "name": "oem_wiki_description",
            "refers": "parents.brand.oem_wiki_description"
        },
        {
            "name": "vehicle_model_name",
            "type": "text",
            "indexed": true
        },
        {
            "name": "vehicle_model_aliases",
            "type": "string_list",
            "converter": {
                "function": "ensure_in_list",
                "args": [
                    "vehicle_model_name"
                ]
            }
        },
        {
            "name": "vehicle_description",
            "type": "text"
        },
        {
            "name": "vehicle_image",
            "type": "text",
            "ui_element": "image",
            "constraint": {
                "function": "url_validator"
            },
            "converter": {
                "function": "url_converter"
            }
        },
        {
            "name": "vehicle_video",
            "type": "text",
            "ui_element": "video",
            "constraint": {
                "function": "url_validator"
            },
            "converter": {
                "function": "url_converter"
            }
        },
        {
            "name": "vehicle_category",
            "type": "text",
            "options": [
                "Passenger vehicles",
                "Commercial Vehicles",
                "Two Wheelers",
                "Three Wheelers",
                "Truck",
                "Bus"
            ],
            "ui_element": "select"
        },
        {
            "name": "vehicle_type",
            "type": "text",
            "options": [
                "Hatchback",
                "Sedan",
                "SUV",
                "MUV",
                "Van",
                "Minivan",
                "Coupe",
                "Convertible",
                "Station Wagon",
                "Pickup Truck",
                "Sports Car",
                "Luxury Sedan",
                "Luxury SUV",
                "Luxury MUV",
                "Luxury Van",
                "Luxury Minivan",
                "Luxury Coupe",
                "Luxury Convertible",
                "Luxury Station Wagon",
                "Luxury Pickup Truck",
                "Electric Vehicle",
                "Hybrid",
                "Bus",
                "Container Truck",
                "Tractor",
                "Trailer",
                "Goods Vehicle",
                "Auto-rickshaw",
                "Tempo",
                "Tempo Traveller",
                "Motorcycle",
                "Scooter",
                "Sports Bike",
                "Cruiser",
                "Naked Bike",
                "Dual-Sport",
                "Enduro",
                "Supermoto",
                "Scrambler",
                "Dirt Bike",
                "Motocross",
                "Other"
            ],
            "ui_element": "select"
        },
        {
            "name": "vehicle_type_aliases",
            "type": "string_list",
            "converter": {
                "function": "ensure_in_list",
                "args": [
                    "vehicle_category",
                    "vehicle_type"
                ]
            }
        },
        {
            "name": "engine_types",
            "type": "list",
            "options": [
                "Petrol",
                "Diesel",
                "CNG",
                "Electric",
                "Hybrid",
                "LPG",
                "Hydrogen"
            ]
        },
        {
            "name": "transmission_types",
            "type": "list",
            "options": [
                "Automatic",
                "Clutchless Manual",
                "Manual",
                "CVT",
                "DCT",
                "Other"
            ]
        },
        {
            "name": "transmission_types_aliases",
            "type": "string_list",
            "converter": {
                "function": "ensure_in_list",
                "args": [
                    "transmission_types"
                ]
            }
        },
        {
            "name": "year_launched",
            "type": "number"
        },
        {
            "name": "feature_summary",
            "type": "text"
        },
        {
            "name": "competitor_vehicles",
            "type": "string_list"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "vehicle_model_name",
                    "brand_name"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "case": "lower",
                    "attribute_join": "-",
                    "is_unique": true,
                    "separator": "-"
                }
            },
            "name": "vehicle_model_id",
            "type": "uid",
            "id": true
        }
    ],
    "parents": [
        "brand"
    ]
}
