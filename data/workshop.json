{
  "timezone": "Asia/Kolkata",
  "name": "workshop",
  "model_type": "default",
  "attributes": [
    {
      "name": "created",
      "type": "number",
      "auto_updater": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "updated",
      "type": "number",
      "auto_updater": true,
      "force_update": true,
      "default": {
        "function": "now_ctime"
      }
    },
    {
      "name": "dealership_id",
      "refers": "parents.dealership.dealership_id",
      "indexed": true,
      "default": {
        "function": "name_to_id",
        "args": [
          "dealer_name",
          "dealer_group_name",
          "region_name"
        ],
        "kwargs": {
          "attribute_join": "-",
          "is_unique": true,
          "separator": "-",
          "case": "title",
          "skip_empty": true
        }
      }
    },
    {
      "name": "dealer_group_name",
      "refers": "parents.dealership.dealer_group_name"
    },
    {
      "name": "dealer_name",
      "refers": "parents.dealership.dealer_name"
    },
    {
      "name": "supported_brands",
      "type": "list",
      "default": {
        "function": "get_from_model",
        "args": [
          "dealership",
          "dealership_id",
          "supported_brands"
        ]
      }
    },
    {
      "name": "region_id",
      "refers": "parents.dealership.region_id",
      "default": {
        "function": "search_in_model",
        "args": [
          "region",
          "region_id"
        ],
        "kwargs": {
          "region_name": "{region_name}"
        }
      }
    },
    {
      "name": "region_name",
      "refers": "parents.dealership.region_name"
    },
    {
      "name": "workshop_name",
      "type": "text",
      "indexed": true
    },
    {
      "name": "workshop_code",
      "type": "text"
    },
    {
      "name": "workshop_full_name",
      "type": "text",
      "indexed": true,
      "default": {
        "function": "name_to_id",
        "args": [
          "dealer_name",
          "workshop_name"
        ],
        "kwargs": {
          "attribute_join": "-",
          "is_unique": true,
          "separator": "-",
          "case": "title",
          "skip_empty": true
        }
      }
    },
    {
      "name": "workshop_code",
      "type": "text",
      "indexed": true,
      "default": {
        "function": "copy_attribute",
        "args": [
          "workshop_name"
        ]
      }
    },
    {
      "name": "workshop_type",
      "type": "text",
      "options": [
        "Main Workshop",
        "Satellite Workshop",
        "Mobile Workshop",
        "Body Shop",
        "Express Service Center"
      ]
    },
    {
      "name": "contact_number",
      "type": "text"
    },
    {
      "name": "email",
      "type": "text"
    },
    {
      "name": "address",
      "type": "text"
    },
    {
      "name": "city",
      "type": "text"
    },
    {
      "name": "state",
      "type": "text"
    },
    {
      "name": "pincode",
      "type": "text"
    },
    {
      "name": "geolocation",
      "type": "geolocation"
    },
    {
      "name": "operating_hours",
      "type": "nested_object"
    },
    {
      "name": "days_open",
      "type": "string_list",
      "ui_element": "multiselect",
      "option_others": true,
      "options": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ]
    },
    {
      "name": "total_service_bays",
      "type": "number"
    },
    {
      "name": "total_technicians",
      "type": "number"
    },
    {
      "name": "daily_service_capacity",
      "type": "number"
    },
    {
      "name": "services_offered",
      "type": "string_list",
      "ui_element": "multiselect",
      "option_others": true,
      "options": [
        "General Service",
        "Repair",
        "Body Shop",
        "Paint",
        "Tyre Alignment",
        "Wheel Balancing",
        "AC Service",
        "Battery Service",
        "Electrical Work",
        "Detailing",
        "Car Wash",
        "Pickup & Drop",
        "Roadside Assistance"
      ]
    },
    {
      "name": "facilities_available",
      "type": "string_list",
      "ui_element": "multiselect",
      "option_others": true,
      "options": [
        "Customer Lounge",
        "Wi-Fi",
        "Cafe / Refreshments",
        "Insurance Desk",
        "Accessories Section",
        "EV Charging Point",
        "Children Play Area",
        "Parking Facility",
        "Virtual Reality Experience",
        "Online Booking Portal",
        "Extended Working Hours",
        "Personal Service Executive",
        "Weekend Availability",
        "Festive Offers",
        "Loyalty Programs",
        "CCTV Waiting Area",
        "Quick Service Bay",
        "Wheel Alignment",
        "Car Washing and Cleaning",
        "Shampoo and Polishing",
        "Associated Showroom",
        "Associated Car-Exchange Center",
        "Credit Card Payment Facility",
        "Debit Card Payment Facility",
        "UPI Payment Facility",
        "Cash Payment Facility",
        "Cheque Payment Facility"
      ]
    },
    {
      "name": "manager_name",
      "type": "text"
    },
    {
      "name": "manager_contact",
      "type": "text"
    },
    {
      "name": "workshop_status",
      "type": "text",
      "options": [
        "Active",
        "Inactive",
        "Under Renovation"
      ],
      "indexed": true
    },
    {
      "name": "display_vehicle_count",
      "type": "number"
    },
    {
      "name": "google_reviews_rating",
      "type": "text"
    },
    {
      "name": "google_reviews",
      "type": "text"
    },
    {
      "name": "google_my_business_listing",
      "type": "text"
    },
    {
      "name": "workshop_reviews",
      "type": "text"
    },
    {
      "name": "workshop_photos",
      "type": "text"
    },
    {
      "name": "workshop_rating",
      "type": "text"
    },
    {
      "name": "region_level_guidelines",
      "refers": "parents.dealership.region_level_guidelines"
    },
    {
      "name": "region_level_guardrails",
      "refers": "parents.dealership.region_level_guardrails"
    },
    {
      "name": "supported_brands_guidelines",
      "refers": "parents.dealership.supported_brands_guidelines"
    },
    {
      "name": "region_subdivision_id",
      "refers": "parents.region_subdivision.subdivision_id",
      "options": "/options/region_subdivision/subdivision_name?region_id={region_id}"
    },
    {
      "name": "subdivision_name",
      "refers": "parents.region_subdivision.subdivision_name"
    },
    {
      "name": "timezone",
      "refers": "parents.region_subdivision.timezone"
    },
    {
      "name": "languages",
      "refers": "parents.region_subdivision.languages"
    },
    {
      "name": "subdivision_level_guidelines",
      "refers": "parents.region_subdivision.subdivision_level_guidelines"
    },
    {
      "name": "subdivision_level_guardrails",
      "refers": "parents.region_subdivision.subdivision_level_guardrails"
    },
    {
      "name": "workshop_level_guidelines",
      "type": "text"
    },
    {
      "name": "workshop_level_guardrails",
      "type": "text"
    },
    {
      "name": "hashtags",
      "type": "string_list",
      "list_type": "text",
      "indexed": true,
      "ui_element": "tags"
    },
    {
      "auto_updater": true,
      "default": {
        "args": [
          "dealer_name",
          "workshop_name",
          "city"
        ],
        "function": "name_to_id",
        "kwargs": {
          "attribute_join": "-",
          "is_unique": true,
          "separator": "-",
          "skip_empty": true,
          "case": "lower"
        }
      },
      "name": "workshop_id",
      "type": "uid",
      "id": true
    }
  ],
  "parents": [
    "dealership",
    "region_subdivision"
  ]
}