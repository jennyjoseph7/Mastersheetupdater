{
    "timezone": "Asia/Kolkata",
    "name": "dealership",
    "model_type": "default",
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name":"campaign_workflow_id",
            "refers":"parents.campaign_workflow.campaign_workflow_id",
            "required":true
        },

        {
            "name" : "session_id",
            "type" : "text" 
        },
       {
            "name" : "campaign_id",
            "type" : "text",
            "indexed" : true,
            "default" : "inbound",
            "required":true
        },
        {
            "name" : "campaign_type",
            "type" : "text",
            "options" : ["inbound","pre_sales","post_sales","dealer"],
            "default" : "inbound",
            "required":true
        },
        {
            "name":"provider_status",
            "type":"text",
            "converter":{
                "function":"to_lowercase"
            }
        }
    ],

    "parents":[
        "campaign_workflow"
    ]
}