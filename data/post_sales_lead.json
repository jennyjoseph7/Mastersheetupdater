{
    "name": "post_sales_lead",
    "model_type": "default",
    "parents": [
        "post_sales_campaign"
    ],
    "attributes": [
        {
            "name": "created",
            "type": "number",
            "auto_updater": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "updated",
            "type": "number",
            "auto_updater": true,
            "force_update": true,
            "default": {
                "function": "now_ctime"
            }
        },
        {
            "name": "vehicle_id",
            "type": "uid",
            "required": true
        },
        {
            "name": "vehicle_brand",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_brand"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "vehicle_id"
        },
        {
            "name": "vehicle_model",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_model"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "vehicle_id"
        },
        {
            "name": "vehicle_variant",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "vehicle_variant"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "vehicle_id"
        },
        {
            "name": "reg_number",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "reg_number"
                ]
            }
        },
        {
            "name": "vin_number",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "vehicle",
                    "vehicle_id",
                    "reg_number"
                ]
            }
        },
        {
            "name": "persons_involved",
            "type": "object_list",
            "dict_keys": [
                "user_id",
                "person_name",
                "last_contacted_whatsapp_number",
                "last_contacted_email",
                "last_contacted_phone_number"
            ],
            "auto_updater": true,
            "force_update": "vehicle_id",
            "default": {
                "function": "pivot_from_model",
                "args": [
                    "person_vehicle",
                    "vehicle_id",
                    "unique_object_list"
                ],
                "kwargs": {
                    "vehicle_id": "{vehicle_id}"
                }
            }
        },
        {
            "type": "number",
            "name": "customer_score"
        },
        {
            "name": "dealership_id",
            "type": "uid",
            "required": true
        },
        {
            "name": "dealer_name",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_name"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "dealer_location",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_location"
                ]
            },
            "indexed": true,
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "dealer_address",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "dealer_address"
                ]
            },
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "region_id",
            "default": {
                "function": "get_from_model",
                "args": [
                    "dealership",
                    "dealership_id",
                    "region_id"
                ]
            },
            "auto_updater": true,
            "force_update": "dealership_id"
        },
        {
            "name": "region_name",
            "default": {
                "function": "get_from_model",
                "args": [
                    "region",
                    "region_id",
                    "region_name"
                ]
            },
            "auto_updater": true,
            "force_update": "dealership_id",
            "indexed": true
        },
        {
            "name": "campaign_id",
            "type": "uid",
            "required": false,
            "refers": "parents.post_sales_campaign.campaign_id"
        },
        {
            "name": "campaign_name",
            "refers": "parents.post_sales_campaign.campaign_name"
        },
        {
            "name": "campaign_type",
            "refers": "parents.post_sales_campaign.campaign_type"
        },
        {
            "name": "workshop_id",
            "type": "uid",
            "required": false
        },
        {
            "name": "workshop_name",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "workshop",
                    "workshop_id",
                    "workshop_name"
                ]
            },
            "auto_updater": true,
            "force_update": "workshop_id"
        },
        {
            "name": "workshop_address",
            "type": "text",
            "default": {
                "function": "get_from_model",
                "args": [
                    "workshop",
                    "workshop_id",
                    "address"
                ]
            },
            "auto_updater": true,
            "force_update": "workshop_id"
        },
        {
            "auto_updater": true,
            "default": {
                "args": [
                    "vehicle_reg_number",
                    "dealership_name",
                    "campaign_name"
                ],
                "function": "name_to_id",
                "kwargs": {
                    "attribute_join": " ",
                    "is_unique": true,
                    "separator": " - ",
                    "skip_empty": true
                }
            },
            "name": "post_sales_lead_id",
            "type": "uid",
            "id": true
        },
        {
            "name": "last_session_id",
            "type": "uid"
        },
        {
            "name": "last_session_status",
            "type": "text",
            "auto_updater": true,
            "force_update": "last_session_id",
            "default": {
                "function": "get_from_model",
                "args": [
                    "session",
                    "last_session_id",
                    "status"
                ]
            }
        },
        {
            "name": "last_session_channel",
            "type": "text",
            "options": [
                "whatsapp",
                "email",
                "voice_phone",
                "web_chat",
                "web_chat_voice",
                "fb_chat",
                "insta_chat",
                "twitter_chat",
                "zoom_bot",
                "ms_teams"
            ],
            "default": {
                "function": "get_from_model",
                "args": [
                    "session",
                    "last_session_id",
                    "channel"
                ]
            },
            "auto_updater": true,
            "force_update": "last_session_id"
        },
        {
            "name": "disposition",
            "type": "text",
            "options": [
                "queued",
                "attempted",
                "reached",
                "contacted",
                "engaged",
                "converted",
                "failed",
                "error"
            ],
            "default": "queued"
        },
        {
            "name": "prioritization_score",
            "type": "number"
        },
        {
            "name": "prioritization_category",
            "type": "text",
            "options": [
                "HOT",
                "WARM",
                "COOL",
                "COLD",
                "INACTIVE"
            ]
        },
        {
            "name": "disposition_detail",
            "type": "text",
            "options": [
                "Invalid no.",
                "Not registered on Whatsapp",
                "User's no. is part of an experiment",
                "Message undeliverable",
                "Unable to send message",
                "Unable to deliver message to deliver message/Unsubcribed",
                "Message not delivered to maintained healty ecosystem management",
                "Invalid / Doesn't exist",
                "DND",
                "Not reachable",
                "Didnt pickup",
                "Rejected",
                "Vehicle is commercial or part of a fleet",
                "Vehicle is not being run",
                "Requires special spare parts",
                "Others",
                "Wrong contact number",
                "Voicemail",
                "Has sold/given away the car",
                "Has moved to another location",
                "Cannot make decision on servicing",
                "Will call showroom themselves",
                "Looking for a discount",
                "Language barrier",
                "Has serviced car in another dealership",
                "Will decide tomorrow",
                "Will decide within 1 to 3 days",
                "Will decide within 4 to 7 days",
                "Will decide within 8 to 14 days",
                "Will decide within 15 to 30 days",
                "Will decide within 31 to 60 days",
                "Will decide within 61 to 90 days",
                "Will decide after 90 days"
            ],
            "option_others" : true
        },
        {
            "name": "follow_up_date",
            "type": "number"
        }
    ]
}